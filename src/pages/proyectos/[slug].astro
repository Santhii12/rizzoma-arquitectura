---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { availableProjects, projects } from '@/data/projects';

export function getStaticPaths() {
  return availableProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = availableProjects.length > 1
  ? availableProjects[(availableProjects.findIndex((item) => item.slug === project.slug) + 1) % availableProjects.length]
  : undefined;
import { withBase } from '@/utils/paths';
---
<BaseLayout
  title={`${project.title} | Rizzoma Arquitectura`}
  description={project.intro ?? project.statement}
  image={project.cover}
  type="article"
>
  <article class="project-detail">
    <header class="project-hero section-pad">
      <div class="project-hero-meta reveal">
        <span>{String(projectIndex + 1).padStart(2, '0')} / Proyecto</span>
        <span>{project.category}{project.year ? ` · ${project.year}` : ''}</span>
      </div>
      <h1 class="project-title reveal">{project.title}</h1>
      <div class="project-title-foot reveal">
        <p>{project.statement}</p>
        {project.location && <span>{project.location}{project.region ? ` · ${project.region}` : ''}</span>}
      </div>
    </header>

    {project.cover && (
      <div class="project-cover parallax-media">
        <img src={project.cover} alt={`${project.title} — vista principal`} fetchpriority="high" decoding="async" />
      </div>
    )}

    <section class="project-summary section-pad">
      <p class="eyebrow reveal">Proyecto</p>
      <div>
        {project.intro && <h2 class="statement statement--project reveal">{project.intro}</h2>}
        <dl class="project-facts reveal">
          {project.location && <div><dt>Ubicación</dt><dd>{project.location}{project.region ? `, ${project.region}` : ''}</dd></div>}
          {project.year && <div><dt>Año</dt><dd>{project.year}</dd></div>}
          <div><dt>Tipología</dt><dd>Vivienda</dd></div>
          <div><dt>Alcance</dt><dd>{project.category}</dd></div>
          <div><dt>Estudio</dt><dd>Rizzoma Arquitectura</dd></div>
          <div><dt>Dirección</dt><dd>{site.founder.name}</dd></div>
        </dl>
      </div>
    </section>

    {project.gallery?.[1] && (
      <section class="project-editorial section-pad no-top">
        <figure class="editorial-tall reveal"><img src={project.gallery[1]} alt={`${project.title} — relación entre arquitectura y paisaje`} loading="lazy" decoding="async" /></figure>
        <div class="editorial-copy reveal">
          <p class="eyebrow">Idea central</p>
          <p>La arquitectura se abre al territorio sin perder intimidad. La secuencia de patios, terrazas y aperturas construye una transición gradual entre interior y exterior.</p>
        </div>
      </section>
    )}

    {project.sections?.map((section, i) => (
      <section class="project-chapter section-pad">
        <div class="chapter-heading reveal"><span>{String(i + 1).padStart(2, '0')}</span><h2>{section.title}</h2></div>
        <p class="large-copy reveal">{section.text}</p>
        {project.gallery?.[i + 2] && (
          <figure class={`chapter-image chapter-image--${(i % 2) + 1} reveal`}>
            <img src={project.gallery[i + 2]} alt={`${project.title} — ${section.title.toLowerCase()}`} loading="lazy" decoding="async" />
          </figure>
        )}
      </section>
    ))}

    <section class="project-end section-pad">
      <p class="eyebrow reveal">¿Tienes un proyecto?</p>
      <a class="closing-copy project-end-link reveal" href={withBase('/contacto/')}>Conversemos sobre él. <span aria-hidden="true">↗</span></a>
      {nextProject && <a class="text-link reveal" href={withBase(`/proyectos/${nextProject.slug}/`)}>Siguiente proyecto · {nextProject.title} ↗</a>}
    </section>
  </article>
</BaseLayout>
