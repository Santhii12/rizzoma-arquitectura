---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectEditorial from '@/components/ProjectEditorial.astro';
import { site } from '@/config/site';
import { availableProjects } from '@/data/projects';
import { withBase } from '@/utils/paths';

export function getStaticPaths() {
  return availableProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const projectIndex = availableProjects.findIndex((entry) => entry.slug === project.slug);
const nextProject = availableProjects[projectIndex + 1];
const baseSite = Astro.site ?? new URL(site.domain);
const projectUrl = new URL(withBase(`/proyectos/${project.slug}/`), baseSite).toString();
const root = baseSite.toString().replace(/\/$/, '');
const absolute = (src: string) => src.startsWith('http') ? src : new URL(src, baseSite).toString();
const allImages = [
  ...(project.cover ? [project.cover] : []),
  ...(project.tour ?? []).flatMap((group) => group.images.map((image) => image.src)),
  ...(project.sections ?? []).flatMap((section) => section.image ? [section.image.src] : []),
  ...(project.archive ?? []).flatMap((group) => group.images.map((image) => image.src))
];
const imageUrls = [...new Set(allImages)].map(absolute);
const socialCover = project.cover ? absolute(project.cover) : site.ogImage;
const projectSchema = [
  {
    '@type': 'CreativeWork',
    '@id': `${projectUrl}#project`,
    name: project.title,
    headline: project.statement || project.title,
    description: project.intro || project.statement || project.category,
    url: projectUrl,
    ...(imageUrls.length ? { image: imageUrls } : {}),
    ...(project.year ? { dateCreated: project.year } : {}),
    creator: { '@id': `${root}/#business` },
    author: { '@id': `${root}/#juan-jose-quintero` },
    about: ['Arquitectura', project.category],
    ...(project.participation ? { creditText: `Participación de Rizzoma: ${project.participation}` } : {}),
    inLanguage: 'es-CO',
    ...(project.location ? {
      locationCreated: {
        '@type': 'Place',
        name: [project.location, project.region].filter(Boolean).join(', '),
        address: {
          '@type': 'PostalAddress',
          addressLocality: project.location,
          ...(project.region ? { addressRegion: project.region } : {}),
          addressCountry: 'CO'
        }
      }
    } : {})
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Portafolio', item: new URL(withBase('/portafolio/'), baseSite).toString() },
      { '@type': 'ListItem', position: 3, name: project.title, item: projectUrl }
    ]
  }
];
---
<BaseLayout
  title={`${project.title} | Rizzoma Arquitectura`}
  description={project.intro ?? project.statement ?? project.category}
  image={socialCover}
  imageAlt={project.coverAlt ?? `Imagen principal de ${project.title}`}
  type="article"
  compactFooter
  schema={projectSchema}
>
  <ProjectEditorial
    project={project}
    index={projectIndex}
    total={availableProjects.length}
    nextProject={nextProject}
  />
</BaseLayout>