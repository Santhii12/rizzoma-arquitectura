---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, availableProjects } from '@/data/projects';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';

const archiveProjects = projects.filter((project) => !project.available);
const baseSite = Astro.site ?? new URL(site.domain);
const pageUrl = new URL(withBase('/proyectos/'), baseSite).toString();
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    name: 'Proyectos — Rizzoma Arquitectura',
    url: pageUrl,
    description: 'Portafolio de arquitectura, interiorismo y visualización de Rizzoma Arquitectura.',
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` }
  },
  {
    '@type': 'ItemList',
    name: 'Portafolio Rizzoma',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      ...(project.available
        ? { url: new URL(withBase(`/proyectos/${project.slug}/`), baseSite).toString() }
        : {})
    }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Proyectos', item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title="Portafolio de arquitectura y visualización | Rizzoma"
  description="Selección de proyectos de arquitectura, vivienda, interiorismo y visualización de Rizzoma Arquitectura."
  schema={schema}
>
  <section class="portfolio-page-hero section-pad">
    <div class="portfolio-page-heading reveal">
      <div>
        <p class="eyebrow">Portafolio / {String(projects.length).padStart(2, '0')}</p>
        <h1>Proyectos</h1>
      </div>
      <p>Una selección breve de arquitectura, interiorismo y visualización desarrollada desde Rizzoma.</p>
    </div>
  </section>

  {availableProjects.length > 0 && (
    <section class="portfolio-page-featured section-pad no-top">
      <div class="portfolio-page-label reveal">
        <span>Proyecto destacado</span>
        <span>01</span>
      </div>
      <div class="project-list project-list--documented">
        {availableProjects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </section>
  )}

  {archiveProjects.length > 0 && (
    <section class="portfolio-page-archive section-pad no-top">
      <div class="portfolio-page-label reveal">
        <span>Selección de archivo</span>
        <span>{String(archiveProjects.length).padStart(2, '0')}</span>
      </div>

      <div class="portfolio-project-grid">
        {archiveProjects.map((project, i) => (
          <article class="portfolio-project-tile reveal">
            <div class="portfolio-project-tile-top">
              <span>{String(i + availableProjects.length + 1).padStart(2, '0')}</span>
              <span>{project.year ?? '—'}</span>
            </div>
            <div class="portfolio-project-tile-center" aria-hidden="true">
              <img src={withBase(site.brand.monogram)} alt="" width="160" height="160" loading="lazy" />
            </div>
            <div class="portfolio-project-tile-bottom">
              <h2>{project.title}</h2>
              <p>{project.category}</p>
              {(project.location || project.region) && (
                <span>{[project.location, project.region].filter(Boolean).join(' · ')}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="portfolio-page-cta dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">Rizzoma Arquitectura</p>
      <p class="closing-copy reveal">¿Quieres desarrollar o visualizar un proyecto?</p>
      <a class="primary-link reveal" href={withBase('/contacto/')}>Conversemos <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
