---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, availableProjects } from '@/data/projects';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';

const archiveProjects = projects.filter((project) => !project.available);
const baseSite = Astro.site ?? new URL(site.domain);
const pageUrl = new URL(withBase('/proyectos/'), baseSite).toString();

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    name: 'Proyectos — Rizzoma Arquitectura',
    url: pageUrl,
    description: 'Casos de arquitectura y visualización de Rizzoma Arquitectura.',
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` }
  },
  {
    '@type': 'ItemList',
    name: 'Proyectos de Rizzoma',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      ...(project.available
        ? { url: new URL(withBase(`/proyectos/${project.slug}/`), baseSite).toString() }
        : {})
    }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Proyectos', item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title="Proyectos de arquitectura y visualización | Rizzoma"
  description="Casos de arquitectura y visualización que muestran el pensamiento, las decisiones y las capacidades de Rizzoma."
  schema={schema}
>
  <section class="rizzoma-projects-hero section-pad">
    <div class="rizzoma-projects-hero-grid reveal">
      <div>
        <p class="eyebrow">Proyectos</p>
        <h1>El trabajo como argumento.</h1>
      </div>
      <div>
        <p>Rizzoma presenta los proyectos como casos de estudio: contexto, participación, decisiones y resultados que puedan demostrarse.</p>
        <a class="text-link" href={withBase('/portafolio/')} target="_blank" rel="noopener noreferrer">Explorar archivo visual ↗</a>
      </div>
    </div>
  </section>

  {availableProjects.length > 0 && (
    <section class="rizzoma-projects-cases section-pad no-top">
      <div class="rizzoma-projects-label reveal">
        <span>Casos documentados</span>
        <span>{String(availableProjects.length).padStart(2, '0')}</span>
      </div>

      <div class="project-list project-list--documented">
        {availableProjects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </section>
  )}

  {archiveProjects.length > 0 && (
    <section class="rizzoma-projects-archive section-pad no-top">
      <div class="rizzoma-projects-label reveal">
        <span>Archivo en preparación</span>
        <span>{String(archiveProjects.length).padStart(2, '0')}</span>
      </div>

      <div class="rizzoma-projects-archive-list">
        {archiveProjects.map((project, i) => (
          <article class="rizzoma-projects-archive-row reveal">
            <span>{String(i + availableProjects.length + 1).padStart(2, '0')}</span>
            <h2>{project.title}</h2>
            <p>{project.category}</p>
            <small>{project.year ?? 'Información en revisión'}</small>
          </article>
        ))}
      </div>

      <p class="rizzoma-projects-archive-note reveal">Los proyectos del archivo se convertirán en casos completos a medida que se confirme su información, autoría y material visual.</p>
    </section>
  )}

  <section class="rizzoma-projects-close dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">Dos maneras de explorar</p>
      <h2 class="reveal">Casos para entender el trabajo. Un archivo visual para descubrirlo.</h2>
      <div class="rizzoma-projects-close-actions reveal">
        <a class="primary-link" href={withBase('/portafolio/')} target="_blank" rel="noopener noreferrer">Explorar archivo visual <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={withBase('/contacto/')}>Conversar sobre un proyecto ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
