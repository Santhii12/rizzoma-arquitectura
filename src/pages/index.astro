---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, featuredProject } from '@/data/projects';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';

const archiveProjects = projects.filter((project) => !project.available).slice(0, 3);
const baseSite = Astro.site ?? new URL(site.domain);
const homeUrl = new URL(withBase('/'), baseSite).toString();
const schema = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#page`,
  name: 'Rizzoma Arquitectura',
  description: site.description,
  url: homeUrl,
  inLanguage: 'es-CO',
  isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
  about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` },
  primaryImageOfPage: featuredProject?.cover
    ? { '@type': 'ImageObject', contentUrl: featuredProject.cover }
    : undefined
};
---
<BaseLayout schema={schema}>
  <section class="hero hero-home">
    <div class="hero-topline reveal">
      <span>Estudio independiente</span>
      <span>{site.location}</span>
      <span>Arquitectura + visualización</span>
    </div>

    <div class="hero-title-wrap brand-hero-title">
      <h1 class="sr-only">Rizzoma Arquitectura</h1>
      <img
        class="hero-wordmark-image hero-title"
        data-hero-title
        src={withBase(site.brand.wordmark)}
        alt=""
        width="1000"
        height="220"
        decoding="async"
      />
      <div class="hero-deck-wrap reveal">
        <p class="hero-deck">Arquitectura y visualización con una mirada directa sobre lugar, materia y forma de habitar.</p>
        <a class="hero-inline-link" href={withBase('/contacto/')}>Cuéntanos tu proyecto ↗</a>
      </div>
    </div>

    {featuredProject?.cover && (
      <a
        href={withBase(`/proyectos/${featuredProject.slug}/`)}
        class="hero-media reveal parallax-media"
        aria-label={`Ver ${featuredProject.title}`}
      >
        <img
          src={featuredProject.cover}
          alt={`${featuredProject.title}, proyecto de Rizzoma`}
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-media-caption">
          <span>{featuredProject.title}</span>
          <span>{featuredProject.location} · {featuredProject.year}</span>
        </div>
      </a>
    )}
  </section>

  <section id="proyectos" class="portfolio-home section-pad">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Portafolio</p>
        <h2 class="section-title">Trabajo seleccionado</h2>
      </div>
      <a class="text-link" href={withBase('/portafolio/')}>Abrir portafolio ↗</a>
    </div>

    {featuredProject && (
      <div class="portfolio-featured">
        <ProjectCard project={featuredProject} index={0} />
      </div>
    )}

    {archiveProjects.length > 0 && (
      <div class="portfolio-mini-grid reveal">
        {archiveProjects.map((project, i) => (
          <article class="portfolio-mini-card">
            <div class="portfolio-mini-top">
              <span>{String(i + 2).padStart(2, '0')}</span>
              <span>{project.year ?? 'Archivo'}</span>
            </div>
            <div class="portfolio-mini-copy">
              <h3>{project.title}</h3>
              <p>{project.category}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="services-compact dark-block">
    <div class="section-pad">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Servicios</p>
          <h2 class="section-title">Del espacio a la imagen.</h2>
        </div>
        <a class="text-link" href={withBase('/servicios/')}>Ver servicios ↗</a>
      </div>

      <div class="services-compact-grid">
        <a class="service-compact-card reveal" href={withBase('/arquitectura-medellin/')}>
          <span>01</span>
          <h3>Arquitectura</h3>
          <p>Vivienda, remodelación y conceptualización.</p>
          <b aria-hidden="true">↗</b>
        </a>
        <a class="service-compact-card reveal" href={withBase('/servicios/#diseno-visualizacion')}>
          <span>02</span>
          <h3>Diseño + visualización</h3>
          <p>Diseñar y representar como un mismo proceso.</p>
          <b aria-hidden="true">↗</b>
        </a>
        <a class="service-compact-card reveal" href={withBase('/visualizacion-arquitectonica-medellin/')}>
          <span>03</span>
          <h3>Visualización</h3>
          <p>Renders, atmósfera, materialidad y comunicación.</p>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
  </section>

  <section class="studio-compact section-pad">
    <figure class="studio-compact-image reveal">
      <img
        src={withBase(site.founder.portrait)}
        alt={`${site.founder.name}, arquitecto y director de Rizzoma`}
        width="300"
        height="375"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="studio-compact-copy reveal">
      <p class="eyebrow">Estudio / {site.founder.name}</p>
      <h2>Una práctica independiente y cercana a cada proyecto.</h2>
      <p>Rizzoma está dirigido directamente por Juan José Quintero Tobón desde Medellín. Arquitectura y visualización se desarrollan como una misma conversación, con atención al contexto, la luz, la materialidad y la experiencia de habitar.</p>

      <div class="studio-compact-meta">
        <div><span>Base</span><strong>{site.location}</strong></div>
        <div><span>Práctica</span><strong>Arquitectura + visualización</strong></div>
      </div>

      <a class="primary-link" href={withBase('/estudio/')}>Conocer el estudio <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-contact-cta dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">¿Tienes un proyecto?</p>
      <p class="closing-copy reveal">Cuéntanos dónde estás y qué quieres crear.</p>
      <a class="primary-link reveal" href={withBase('/contacto/')}>Hablar con Juan José <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
