---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NuestraMirada from '@/components/NuestraMirada.astro';
import QuePodemosHacer from '@/components/QuePodemosHacer.astro';
import { projects, featuredProject } from '@/data/projects';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';
import '@/styles/home-immersive.css';

const heroCover = withBase('/images/studio/home/rizzoma-hero-portada.webp');
const heroProject = projects.find((project) => project.slug === 'casa-patio-horizonte');
const miradaPhoto = heroProject?.gallery?.[1];
const heroImageUrl = new URL(heroCover, Astro.site ?? new URL(site.domain)).toString();
const archiveProjects = projects.filter((project) => !project.available).slice(0, 3);
const baseSite = Astro.site ?? new URL(site.domain);
const homeUrl = new URL(withBase('/'), baseSite).toString();
const schema = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#page`,
  name: 'Rizzoma Arquitectura',
  description: site.description,
  url: homeUrl,
  inLanguage: 'es-CO',
  isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
  about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` },
  primaryImageOfPage: { '@type': 'ImageObject', contentUrl: heroImageUrl }
};
---
<BaseLayout schema={schema} image={heroImageUrl} imageAlt="Casa Patio Horizonte, arquitectura contemporánea integrada al paisaje">
  <section class="rizzoma-immersive-hero" aria-label="Presentación de Rizzoma Arquitectura">
    <div class="rizzoma-hero-media" data-ripple-hero>
      <img
        src={heroCover}
        alt="Casa Patio Horizonte, residencia contemporánea integrada al paisaje y la vegetación"
        fetchpriority="high"
        decoding="async"
        width="2048"
        height="1529"
        data-ripple-image
      />
      <canvas class="rizzoma-hero-canvas" data-ripple-canvas aria-hidden="true"></canvas>
    </div>
    <div class="rizzoma-hero-shade" aria-hidden="true"></div>
    <div class="rizzoma-hero-content">
      <p class="rizzoma-hero-overline">Taller y estudio de arquitectura · Medellín, Colombia</p>
      <h1 class="rizzoma-hero-name">Rizzoma <em>Arquitectura.</em></h1>
      <p class="rizzoma-hero-statement">Hay espacios que cambian la forma de habitar el mundo.</p>
      <p class="rizzoma-hero-description">Diseño arquitectónico y visualización para proyectos en relación con el lugar, la materia y la vida.</p>
      <div class="rizzoma-hero-actions">
        <a href={withBase('/portafolio/')}>Explorar proyectos <span aria-hidden="true">↗</span></a>
        <a href={withBase('/visualizacion-arquitectonica-medellin/')}>Solicitar visualización <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {heroProject && (
      <div class="rizzoma-hero-credit">
        <span>Imagen / {heroProject.title}</span>
        <a href={withBase(`/proyectos/${heroProject.slug}/`)}>Ver proyecto ↗</a>
      </div>
    )}
    <span class="rizzoma-hero-scroll" aria-hidden="true">DESCUBRIR ↓</span>
  </section>

  <NuestraMirada image={miradaPhoto} imageCredit="Casa Patio Horizonte / Rizzoma Arquitectura" />

  <section id="proyectos" class="portfolio-home section-pad">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Portafolio</p>
        <h2 class="section-title">Trabajo seleccionado</h2>
      </div>
      <a class="text-link" href={withBase('/portafolio/')}>Abrir portafolio ↗</a>
    </div>

    {featuredProject && (
      <div class="portfolio-featured">
        <ProjectCard project={featuredProject} index={0} />
      </div>
    )}

    {archiveProjects.length > 0 && (
      <div class="portfolio-mini-grid reveal">
        {archiveProjects.map((project, i) => (
          <article class="portfolio-mini-card">
            <div class="portfolio-mini-top">
              <span>{String(i + 2).padStart(2, '0')}</span>
              <span>{project.year ?? 'Archivo'}</span>
            </div>
            <div class="portfolio-mini-copy">
              <h3>{project.title}</h3>
              <p>{project.category}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <QuePodemosHacer
    visualizacionImage={heroCover}
    disenoImage={heroProject?.gallery?.[2]}
    remodelacionImage={heroProject?.gallery?.[4]}
  />

  <section class="studio-compact section-pad">
    <figure class="studio-compact-image reveal">
      <img
        src={withBase(site.founder.portrait)}
        alt={`${site.founder.name}, arquitecto y director de Rizzoma`}
        width="300"
        height="375"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="studio-compact-copy reveal">
      <p class="eyebrow">Estudio / {site.founder.name}</p>
      <h2>Una práctica independiente y cercana a cada proyecto.</h2>
      <p>Rizzoma está dirigido directamente por Juan José Quintero Tobón desde Medellín. Arquitectura y visualización se desarrollan como una misma conversación, con atención al contexto, la luz, la materialidad y la experiencia de habitar.</p>

      <div class="studio-compact-meta">
        <div><span>Base</span><strong>{site.location}</strong></div>
        <div><span>Práctica</span><strong>Arquitectura + visualización</strong></div>
      </div>

      <a class="primary-link" href={withBase('/estudio/')}>Conocer el estudio <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-contact-cta dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">¿Tienes un proyecto?</p>
      <p class="closing-copy reveal">Cuéntanos dónde estás y qué quieres crear.</p>
      <a class="primary-link reveal" href={withBase('/contacto/')}>Hablar con Juan José <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <script>import '@/scripts/hero-ripple';</script>
</BaseLayout>
