---
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import { projects } from '@/data/projects';
import { withBase } from '@/utils/paths';

const cards = projects.filter((p) => p.slug !== 'el-refugio');
---
<PortfolioLayout title="Portafolio | Rizzoma Arquitectura" description="Obras seleccionadas de arquitectura, interiores y visualización de Rizzoma Arquitectura.">
  <main class="rz-portfolio" id="portfolio-space">
    <header class="rz-portfolio-header">
      <a href={withBase('/')} class="rz-brand" aria-label="Rizzoma, volver al sitio">
        <img src={withBase('/brand/rizzoma-rzm-original.svg')} alt="Rizzoma, monograma RZM" width="565" height="400" />
      </a>
      <span class="rz-header-label">Arquitectura / Estudio independiente</span>
      <a href={withBase('/')} class="rz-back">Volver al sitio <span aria-hidden="true">↗</span></a>
    </header>

    <div class="rz-portfolio-shell">
      <section class="rz-portfolio-editorial">
        <p class="rz-overline">PORTAFOLIO / RIZZOMA</p>
        <h1>Obras<br />seleccionadas<span>.</span></h1>
        <div class="rz-rule"></div>
        <p>Una mirada sobre arquitectura, visualización y la relación entre espacio, materia y territorio.</p>
        <div class="rz-editorial-bottom"><strong>{String(cards.length).padStart(2, '0')}</strong><span>PROYECTOS EN EL ARCHIVO</span></div>
      </section>

      <section class="rz-portfolio-gallery" aria-label="Proyectos de Rizzoma">
        <div class="rz-rings" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="rz-ring-center" aria-hidden="true"><span>R I Z Z O M A</span><small>ARQUITECTURA · MEDELLÍN</small></div>
        <div class="rz-card-grid">
          {cards.map((project, index) => (
            <article class={`rz-project-card rz-card-${index + 1}`}>
              {project.available ? (
                <a class="rz-project-link" href={withBase(`/proyectos/${project.slug}/`)} aria-label={`Abrir proyecto ${project.title}`}>
                  <div class="rz-project-image">
                    {project.cover ? <img src={project.cover} alt={`Portada de ${project.title}`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /> : <div class="rz-cover-placeholder"><span>R / A</span></div>}
                    <span class="rz-image-arrow" aria-hidden="true">↗</span>
                  </div>
                  <div class="rz-card-caption"><div><span class="rz-card-count">{String(index + 1).padStart(2, '0')} /</span><h2>{project.title}</h2><p>{project.category}</p></div><span aria-hidden="true">↗</span></div>
                </a>
              ) : (
                <button type="button" class="rz-project-link rz-project-button" data-archive-open data-title={project.title} data-category={project.category} data-year={project.year ?? ''} data-location={[project.location, project.region].filter(Boolean).join(', ')} aria-label={`Ver datos disponibles de ${project.title}`}>
                  <div class="rz-project-image rz-project-image--pending">
                    {project.cover ? <img src={project.cover} alt={`Portada de ${project.title}`} loading="lazy" decoding="async" /> : <div class="rz-cover-placeholder"><span>R / A</span></div>}
                    <span class="rz-image-arrow" aria-hidden="true">↗</span>
                  </div>
                  <div class="rz-card-caption"><div><span class="rz-card-count">{String(index + 1).padStart(2, '0')} /</span><h2>{project.title}</h2><p>{project.category}</p></div><span aria-hidden="true">↗</span></div>
                </button>
              )}
            </article>
          ))}
        </div>
      </section>
    </div>

    <dialog class="rz-archive-dialog" data-archive-dialog aria-labelledby="rz-archive-title">
      <button type="button" class="rz-dialog-close" data-archive-close aria-label="Cerrar">×</button>
      <p class="rz-overline">ARCHIVO RIZZOMA / PROYECTO</p>
      <h2 id="rz-archive-title" data-archive-title></h2>
      <p data-archive-category></p>
      <div class="rz-dialog-facts"><span data-archive-location></span><span data-archive-year></span></div>
      <p class="rz-dialog-note">La documentación visual y la ficha completa de este proyecto están pendientes de publicación.</p>
      <a href={withBase('/contacto/')}>Consultar sobre este proyecto ↗</a>
    </dialog>
  </main>
  <script>
    // Ordered outward expansion: a short curved arc per card, with no
    // complete turns and no movement after the final CSS position.
    const gallery = document.querySelector<HTMLElement>('.rz-portfolio-gallery');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.rz-project-card'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (gallery && cards.length && !reducedMotion && 'animate' in HTMLElement.prototype) {
      const rect = gallery.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const compact = window.matchMedia('(max-width: 700px)').matches;
      const duration = compact ? 1450 : 1700;
      const stagger = compact ? 130 : 160;
      const smooth = (v: number) => {
        const t = Math.max(0, Math.min(1, v));
        return t * t * (3 - 2 * t);
      };

      // All coordinates are measured before animation starts. Each card
      // grows outward on a gentle clockwise arc ending at its own position.
      const paths = cards.map(card => {
        const target = card.getBoundingClientRect();
        const destX = target.left + target.width / 2;
        const destY = target.top + target.height / 2;
        const dx = destX - centerX;
        const dy = destY - centerY;
        const distance = Math.hypot(dx, dy);
        const endAngle = Math.atan2(dy, dx);
        const arc = compact ? 0.48 : 0.68; // radians, far less than one revolution

        // CSS already applies the final tilt. Animate only the additional
        // translation and scale using individual transform properties, so
        // there is never a rotation jump at the end.
        return Array.from({ length: 81 }, (_, step) => {
          const t = step / 80;
          const p = smooth(t);
          const angle = endAngle - arc * (1 - p);
          const radius = distance * p;
          const x = centerX + Math.cos(angle) * radius;
          const y = centerY + Math.sin(angle) * radius;
          return {
            offset: t,
            opacity: Math.min(1, t * 9),
            translate: `${x - destX}px ${y - destY}px`,
            scale: String(0.84 + 0.16 * p)
          };
        });
      });

      gallery.classList.add('rz-spiral-playing');
      const animations = cards.map((card, index) => card.animate(paths[index], {
        duration,
        delay: 180 + index * stagger,
        easing: 'linear',
        fill: 'backwards'
      }));
      Promise.all(animations.map(animation => animation.finished.catch(() => null))).then(() => {
        animations.forEach(animation => animation.cancel());
        gallery.classList.remove('rz-spiral-playing');
      });
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-archive-dialog]');
    document.querySelectorAll<HTMLButtonElement>('[data-archive-open]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog) return;
        const title = dialog.querySelector<HTMLElement>('[data-archive-title]');
        const category = dialog.querySelector<HTMLElement>('[data-archive-category]');
        const location = dialog.querySelector<HTMLElement>('[data-archive-location]');
        const year = dialog.querySelector<HTMLElement>('[data-archive-year]');
        if (title) title.textContent = button.dataset.title ?? '';
        if (category) category.textContent = button.dataset.category ?? '';
        if (location) { location.textContent = button.dataset.location ?? ''; location.hidden = !button.dataset.location; }
        if (year) { year.textContent = button.dataset.year ?? ''; year.hidden = !button.dataset.year; }
        dialog.showModal();
      });
    });
    document.querySelector('[data-archive-close]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  </script>
</PortfolioLayout>