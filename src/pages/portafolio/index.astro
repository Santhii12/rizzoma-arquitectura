---
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import { availableProjects } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/portfolio-cinematic.css';

const cards = availableProjects;
---
<PortfolioLayout title="Portafolio | Rizzoma Arquitectura" description="Obras seleccionadas de arquitectura, interiores y visualización de Rizzoma Arquitectura.">
  <main class="rz-portfolio" id="portfolio-space">
    <header class="rz-portfolio-header">
      <a href={withBase('/')} class="rz-brand" aria-label="Rizzoma, volver al sitio">
        <img src={withBase('/brand/rizzoma-rzm-original.svg')} alt="Rizzoma, monograma RZM" width="565" height="400" />
      </a>
      <span class="rz-header-label">Arquitectura / Estudio independiente</span>
      <a href={withBase('/')} class="rz-back">Volver al sitio <span aria-hidden="true">↗</span></a>
    </header>

    <section class="rz-cinema-scroll" aria-label="Recorrido cinematográfico por los proyectos" data-cinema-scroll>
      <div class="rz-cinema-sticky">
        <div class="rz-cinema-heading"><section class="rz-portfolio-editorial">
        <p class="rz-overline">PORTAFOLIO / RIZZOMA</p>
        <h1>Obras seleccionadas<span>.</span></h1>
        <div class="rz-rule"></div>
        <p>Una mirada sobre arquitectura, visualización y la relación entre espacio, materia y territorio.</p>
        <nav class="rz-cinema-index" aria-label="Ir a un proyecto del portafolio">
          {cards.map((project, index) => (
            <a
              class="rz-cinema-index__link"
              href={withBase(`/proyectos/${project.slug}/`)}
              data-cinema-jump={index}
              aria-current={index === 0 ? 'true' : undefined}
              aria-label={`Proyecto ${index + 1} de ${cards.length}: ${project.title}`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{project.title}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
        <div class="rz-editorial-bottom"><strong>{String(cards.length).padStart(2, '0')}</strong><span>PROYECTOS EN EL ARCHIVO</span></div>
      </section></div>
        <div class="rz-cinema-topline"><span>RIZZOMA / ARCHIVO VISUAL</span><span data-cinema-counter>01 / {String(cards.length).padStart(2, '0')}</span></div>
        <p class="rz-cinema-instruction">Desplázate para recorrer los proyectos ↓</p>
      <section class="rz-portfolio-gallery" aria-label="Proyectos de Rizzoma">
        <div class="rz-rings" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="rz-ring-center" aria-hidden="true"><span>R I Z Z O M A</span><small>ARQUITECTURA · MEDELLÍN</small></div>
        <div class="rz-card-grid">
          {cards.map((project, index) => (
            <article class={`rz-project-card rz-card-${index + 1}`} data-cinema-card data-index={index}>
              {project.available ? (
                <a class="rz-project-link" href={withBase(`/proyectos/${project.slug}/`)} aria-label={`Abrir proyecto ${project.title}`}>
                  <div class="rz-project-image">
                    {project.cover ? <img src={project.cover} alt={`Portada de ${project.title}`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /> : <div class="rz-cover-placeholder"><span>R / A</span></div>}
                    <span class="rz-image-arrow" aria-hidden="true">↗</span>
                  </div>
                  <div class="rz-card-caption"><div><h2>{project.title}</h2><p class="rz-card-meta">{project.year && <span>{project.year}</span>}<span>{project.category}</span></p></div><span aria-hidden="true">↗</span></div>
                </a>
              ) : (
                <button type="button" class="rz-project-link rz-project-button" data-archive-open data-title={project.title} data-category={project.category} data-year={project.year ?? ''} data-location={[project.location, project.region].filter(Boolean).join(', ')} aria-label={`Ver datos disponibles de ${project.title}`}>
                  <div class="rz-project-image rz-project-image--pending">
                    {project.cover ? <img src={project.cover} alt={`Portada de ${project.title}`} loading="lazy" decoding="async" /> : <div class="rz-cover-placeholder"><span>R / A</span></div>}
                    <span class="rz-image-arrow" aria-hidden="true">↗</span>
                  </div>
                  <div class="rz-card-caption"><div><h2>{project.title}</h2><p class="rz-card-meta">{project.year && <span>{project.year}</span>}<span>{project.category}</span></p></div><span aria-hidden="true">↗</span></div>
                </button>
              )}
            </article>
          ))}
        </div>
      </section>
      </div>
    </section>


  </main>
  <script>import '@/scripts/portfolio-cinematic';</script>
</PortfolioLayout>