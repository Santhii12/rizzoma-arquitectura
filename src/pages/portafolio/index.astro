---
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import { projects } from '@/data/projects';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';

const finalSpecs = [
  { x: 600, y: 145, w: 190, h: 230, r: -2, z: 30 },
  { x: 830, y: 255, w: 215, h: 155, r: 3, z: 28 },
  { x: 830, y: 465, w: 180, h: 225, r: 4, z: 26 },
  { x: 600, y: 575, w: 215, h: 155, r: -2, z: 29 },
  { x: 370, y: 465, w: 185, h: 225, r: -4, z: 27 },
  { x: 370, y: 255, w: 210, h: 155, r: 3, z: 25 }
];

const visualItems = projects.map((project) => ({
  image: project.cover ?? '',
  title: project.title,
  category: project.category,
  location: project.location ?? '',
  region: project.region ?? '',
  year: project.year ?? '',
  statement: project.statement ?? '',
  text: project.intro ?? (
    project.available
      ? 'Proyecto de Rizzoma Arquitectura.'
      : 'Proyecto perteneciente al archivo Rizzoma. La información y documentación visual completa se incorporará cuando esté confirmada.'
  ),
  sections: project.sections ?? [],
  href: project.available ? withBase(`/proyectos/${project.slug}/`) : ''
}));
---
<PortfolioLayout
  title="Portafolio | Rizzoma Arquitectura"
  description="Portafolio interactivo de proyectos de arquitectura y visualización de Rizzoma Arquitectura."
>
  <main
    id="portfolio-space"
    class="portfolio-space is-entry-playing"
    data-space-gallery
    aria-label="Portafolio interactivo de Rizzoma Arquitectura"
  >
    <div class="portfolio-space__topbar">
      <a class="portfolio-space__brand" href={withBase('/')} aria-label="Volver al sitio de Rizzoma">
        <img src={withBase(site.brand.wordmark)} alt="Rizzoma" width="900" height="200" />
      </a>
      <span class="portfolio-space__mode">Portafolio · Estudio · Proyectos</span>
      <div class="portfolio-space__top-actions">
        <button class="portfolio-space__sound" type="button" data-space-sound aria-pressed="true" title="Repetir efecto con sonido">
          Sonido <span aria-hidden="true">↻</span>
        </button>
        <a class="portfolio-space__back" href={withBase('/')}>Volver al sitio ↙</a>
      </div>
    </div>

    <aside class="portfolio-space__editorial" aria-label="Introducción al portafolio"><p>Portafolio / Rizzoma</p><h1>Obras<br />seleccionadas<span>.</span></h1><div class="portfolio-space__gold-rule"></div><p class="portfolio-space__editorial-copy">Arquitectura, visualización y relaciones entre espacio, materia y territorio.</p></aside>

    <div class="portfolio-space__stage" data-space-stage>
      <div class="portfolio-space__world" data-space-world>
        <div class="portfolio-space__center-mark" aria-hidden="true"><span>Arquitectura<br />·<br />Paisaje</span></div>
        {visualItems.map((item, index) => {
          const spec = finalSpecs[index];
          return (
            <button
              class="portfolio-space__item"
              type="button"
              data-space-item
              data-index={index}
              data-final-x={spec.x}
              data-final-y={spec.y}
              data-final-rotate={spec.r}
              data-final-z={spec.z}
              data-image={item.image}
              data-title={item.title}
              data-category={item.category}
              data-location={item.location}
              data-region={item.region}
              data-year={item.year}
              data-statement={item.statement}
              data-text={item.text}
              data-sections={JSON.stringify(item.sections)}
              data-href={item.href}
              style={`--w:${spec.w}px;--h:${spec.h}px;`}
              aria-label={`Abrir información de ${item.title}`}
            >
              <div class="portfolio-space__thumb">
                {item.image ? (
                  <img src={item.image} alt="" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
                ) : (
                  <div class="portfolio-space__placeholder">
                    <img src={withBase(site.brand.monogram)} alt="" aria-hidden="true" width="200" height="200" />
                    <strong>{item.title}</strong>
                  </div>
                )}
              </div>
              <div class="portfolio-space__caption" aria-hidden="true">
                <span>{String(index + 1).padStart(2, '0')} · {item.title}</span>
                <span>Explorar ↗</span>
              </div>
            </button>
          );
        })}
      </div>
    </div>

    <div class="portfolio-space__index">
      <span>{String(visualItems.length).padStart(2, '0')}</span>
      <span>Proyectos seleccionados</span>
    </div>

    <div class="portfolio-space__hint" data-space-hint>
      Explora · arrastra · selecciona
    </div>

    <section
      class="portfolio-space__focus"
      data-space-focus
      data-monogram={withBase(site.brand.monogram)}
      aria-hidden="true"
      aria-label="Información del proyecto"
    >
      <button class="portfolio-space__focus-close" type="button" data-focus-close aria-label="Cerrar">×</button>

      <div class="portfolio-space__focus-inner">
        <div class="portfolio-space__focus-visual" data-focus-visual></div>

        <div class="portfolio-space__focus-meta">
          <span class="portfolio-space__focus-kicker" data-focus-category></span>
          <h2 data-focus-title></h2>
          <p class="portfolio-space__focus-statement" data-focus-statement></p>

          <dl class="portfolio-space__focus-facts">
            <div data-focus-location-row>
              <dt>Ubicación</dt>
              <dd data-focus-location></dd>
            </div>
            <div data-focus-year-row>
              <dt>Año</dt>
              <dd data-focus-year></dd>
            </div>
          </dl>

          <p class="portfolio-space__focus-description" data-focus-text></p>
          <div class="portfolio-space__focus-sections" data-focus-sections></div>
          <a class="portfolio-space__focus-link" data-focus-link href="#">Ver proyecto completo ↗</a>
        </div>
      </div>
    </section>
  </main>
</PortfolioLayout>
