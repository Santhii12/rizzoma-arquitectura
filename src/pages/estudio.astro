---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { featuredProject } from '@/data/projects';
import { withBase } from '@/utils/paths';

const baseSite = Astro.site ?? new URL(site.domain);
const pageUrl = new URL(withBase('/estudio/'), baseSite).toString();
const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${pageUrl}#page`,
    name: 'Estudio — Rizzoma Arquitectura',
    url: pageUrl,
    description: `Rizzoma es una práctica independiente de arquitectura, diseño y visualización dirigida por ${site.founder.name} en Medellín.`,
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    mainEntity: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#juan-jose-quintero` }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Estudio', item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title="Estudio | Juan José Quintero Tobón | Rizzoma"
  description={`Rizzoma es una práctica independiente de arquitectura, diseño y visualización dirigida por ${site.founder.name} en Medellín.`}
  image={site.founder.portrait}
  imageAlt={`${site.founder.name}, arquitecto y director de Rizzoma`}
  schema={schema}
>
  <section class="page-hero section-pad studio-hero rizzoma-studio-page-hero">
    <p class="eyebrow reveal">Estudio</p>
    <h1 class="page-title reveal">Una práctica independiente.<br />Una mirada construida desde las relaciones.</h1>
    <div class="studio-hero-meta reveal">
      <span>Dirección · {site.founder.name}</span>
      <span>{site.location}</span>
    </div>
  </section>

  <section class="rizzoma-studio-profile section-pad no-top">
    <figure class="rizzoma-studio-portrait reveal">
      <img src={withBase(site.founder.portrait)} alt={`${site.founder.name}, arquitecto y director de Rizzoma`} width="300" height="375" fetchpriority="high" decoding="async" />
      <figcaption><span>{site.founder.name}</span><span>{site.founder.role}</span></figcaption>
    </figure>

    <div class="rizzoma-studio-profile-copy reveal">
      <p class="eyebrow">Rizzoma / Medellín</p>
      <h2>El espacio no se entiende de manera aislada.</h2>
      <p>Rizzoma entiende la arquitectura como una relación entre personas, espacio, materia y territorio. Esa lectura orienta tanto los proyectos de diseño como las herramientas visuales utilizadas para estudiarlos y comunicarlos.</p>
      <p>La práctica está dirigida directamente por Juan José Quintero Tobón. La escala independiente permite mantener continuidad de criterio desde la conversación inicial hasta el desarrollo y la representación.</p>
      <p class="rizzoma-studio-direct">El proyecto se conversa directamente con quien lo desarrolla.</p>
    </div>
  </section>

  <section class="rizzoma-studio-principles dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">Relaciones que guían el trabajo</p>
      <div class="rizzoma-studio-principles-grid">
        <article class="reveal"><span>01</span><h3>Personas ↔ espacio</h3><p>Uso, recorridos, ritmos y formas de habitar como punto de partida.</p></article>
        <article class="reveal"><span>02</span><h3>Luz ↔ materia</h3><p>La atmósfera aparece en la manera en que la luz revela superficies, profundidad y textura.</p></article>
        <article class="reveal"><span>03</span><h3>Arquitectura ↔ territorio</h3><p>El paisaje, la orientación y las condiciones del lugar participan en las decisiones del proyecto.</p></article>
        <article class="reveal"><span>04</span><h3>Idea ↔ representación</h3><p>Visualizar sirve para comprobar y comunicar la arquitectura, no solo para adornarla.</p></article>
      </div>
    </div>
  </section>

  {featuredProject?.cover && (
    <section class="rizzoma-studio-project section-pad">
      <div class="rizzoma-studio-project-copy reveal">
        <p class="eyebrow">Trabajo</p>
        <h2>Las ideas se demuestran en proyectos, no en manifiestos.</h2>
        <p>{featuredProject.statement}</p>
        <a class="text-link" href={withBase(`/proyectos/${featuredProject.slug}/`)}>Ver {featuredProject.title} ↗</a>
      </div>
      <figure class="rizzoma-studio-project-image reveal">
        <img src={featuredProject.cover} alt={`${featuredProject.title}, proyecto de Rizzoma`} loading="lazy" decoding="async" />
      </figure>
    </section>
  )}

  <section class="rizzoma-studio-close section-pad">
    <p class="eyebrow reveal">Trabajar con Rizzoma</p>
    <h2 class="reveal">Una relación directa, un alcance claro y decisiones que puedan explicarse.</h2>
    <div class="rizzoma-studio-close-actions reveal">
      <a class="primary-link" href={withBase('/servicios/')}>Conocer servicios <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={withBase('/contacto/')}>Conversar sobre un proyecto ↗</a>
    </div>
  </section>
</BaseLayout>
