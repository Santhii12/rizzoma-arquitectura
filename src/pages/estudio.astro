---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { featuredProject } from '@/data/projects';
import { withBase } from '@/utils/paths';
---
<BaseLayout title="Estudio | Rizzoma Arquitectura" description={`Rizzoma es un estudio emergente e independiente de arquitectura y visualización dirigido por ${site.founder.name} en Medellín, Colombia.`}>
  <section class="page-hero section-pad studio-hero">
    <p class="eyebrow reveal">Estudio</p>
    <h1 class="page-title reveal">Un estudio emergente.<br />Una mirada propia.</h1>
    <div class="studio-hero-meta reveal">
      <span>Dirección · {site.founder.name}</span>
      <span>{site.location}</span>
    </div>
  </section>

  <section class="studio-profile section-pad no-top">
    <figure class="studio-portrait reveal">
      <img src={withBase(site.founder.portrait)} alt={`${site.founder.name}, arquitecto y director de Rizzoma`} width="1000" height="1250" fetchpriority="high" decoding="async" />
      <figcaption><span>{site.founder.name}</span><span>{site.founder.role}</span></figcaption>
    </figure>

    <div class="studio-profile-copy reveal">
      <p class="eyebrow">Rizzoma / Práctica independiente</p>
      <p class="large-copy">Arquitectura entendida como una relación entre lugar, materia y vida cotidiana.</p>
      <div class="studio-profile-body">
        <p>Rizzoma es un estudio de arquitectura y visualización dirigido por Juan José Quintero Tobón. Cada proyecto pasa directamente por su mirada y por una forma de trabajo cercana, desde las primeras ideas hasta su representación.</p>
        <p>La práctica se concentra en comprender el contexto, la forma de habitar, la luz, el paisaje y la materialidad para construir propuestas con identidad propia. La visualización no aparece al final: funciona como una herramienta para diseñar, comprobar y comunicar.</p>
      </div>
      <div class="studio-location"><span>Base</span><strong>{site.location}</strong></div>
    </div>
  </section>

  <section class="values dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">Principios</p>
      <div class="values-grid">
        <div class="reveal"><span>01</span><h3>Contexto</h3><p>Leer el lugar antes de imponer una forma.</p></div>
        <div class="reveal"><span>02</span><h3>Habitar</h3><p>Diseñar desde las personas, sus recorridos, ritmos y necesidades.</p></div>
        <div class="reveal"><span>03</span><h3>Materia</h3><p>Usar materialidad, luz y detalle para construir carácter.</p></div>
        <div class="reveal"><span>04</span><h3>Claridad</h3><p>Hacer comprensibles las decisiones tanto en el espacio como en su representación.</p></div>
      </div>
    </div>
  </section>

  <section class="studio-capabilities section-pad">
    <div class="section-head reveal">
      <div><p class="eyebrow">Capacidades</p><h2 class="section-title">Pensar, desarrollar y comunicar.</h2></div>
      <span class="section-count">Rizzoma / 2026</span>
    </div>
    <div class="capability-grid">
      <div class="reveal"><span>01</span><strong>Diseño arquitectónico</strong><p>Conceptualización, organización espacial y desarrollo de propuestas.</p></div>
      <div class="reveal"><span>02</span><strong>Lectura del lugar</strong><p>Topografía, orientación, paisaje, recorridos y condiciones ambientales como insumos de proyecto.</p></div>
      <div class="reveal"><span>03</span><strong>Desarrollo técnico</strong><p>Planimetría, modelado y documentación de acuerdo con el alcance contratado.</p></div>
      <div class="reveal"><span>04</span><strong>Visualización</strong><p>Imágenes para estudiar y comunicar escala, atmósfera, materialidad e intención arquitectónica.</p></div>
    </div>
  </section>

  {featuredProject?.cover && (
    <section class="studio-project-break">
      <div class="studio-project-image parallax-media">
        <img src={featuredProject.cover} alt={`${featuredProject.title}, proyecto de Rizzoma`} loading="lazy" decoding="async" />
      </div>
      <div class="studio-project-caption section-pad">
        <p class="eyebrow reveal">Trabajo</p>
        <p class="large-copy reveal">Cada proyecto es una oportunidad para construir una relación específica con su lugar.</p>
        <a class="text-link reveal" href={withBase(`/proyectos/${featuredProject.slug}/`)}>Ver {featuredProject.title} ↗</a>
      </div>
    </section>
  )}

  <section class="studio-method section-pad">
    <p class="eyebrow reveal">Método</p>
    <h2 class="statement reveal">Diseñar y visualizar no son dos mundos separados.</h2>
    <div class="manifesto-foot reveal">
      <a class="text-link" href={withBase('/servicios/')}>Ver servicios ↗</a>
      <p>La representación permite evaluar escala, luz, materialidad y atmósfera mientras el proyecto evoluciona. Por eso forma parte del proceso, no solo del resultado final.</p>
    </div>
  </section>

  <section class="founder-cta dark-block">
    <div class="section-pad founder-cta-inner">
      <p class="eyebrow reveal">Contacto directo</p>
      <p class="closing-copy reveal">Tu proyecto se conversa directamente con quien lo va a desarrollar.</p>
      <a class="primary-link reveal" href={withBase('/contacto/')}>Hablar con Juan José <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
