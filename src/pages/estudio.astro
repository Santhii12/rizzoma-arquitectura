---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { featuredProject } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/estudio-refinement.css';

const baseSite = Astro.site ?? new URL(site.domain);
const pageUrl = new URL(withBase('/estudio/'), baseSite).toString();
const studioPortrait = withBase('/images/studio/juan-jose-retrato-editorial.webp');
const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${pageUrl}#page`,
    name: 'Estudio — Rizzoma Arquitectura',
    url: pageUrl,
    description: `Rizzoma es una práctica independiente de arquitectura y visualización dirigida por ${site.founder.name} en Medellín.`,
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    mainEntity: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#juan-jose-quintero` }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Estudio', item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title="Estudio | Rizzoma Arquitectura — Juan José Quintero Tobón"
  description={`Conoce la mirada de Rizzoma, práctica independiente de arquitectura y visualización dirigida por ${site.founder.name} en Medellín: lugar, habitar, materialidad y claridad.`}
  image={studioPortrait}
  imageAlt={`${site.founder.name}, arquitecto y director de Rizzoma`}
  schema={schema}
>
  <div class="rz-estudio">
    <section class="page-hero section-pad studio-hero" aria-labelledby="rz-studio-title">
      <p class="eyebrow reveal">Estudio / Rizzoma</p>
      <h1 class="page-title reveal" id="rz-studio-title">Una práctica independiente.<br />Una mirada propia.</h1>
      <div class="studio-hero-meta reveal">
        <span>Dirección · {site.founder.name}</span>
        <span>{site.location}</span>
      </div>
    </section>

    <section class="studio-profile section-pad no-top" aria-labelledby="rz-studio-profile-title">
      <figure class="studio-portrait reveal">
        <img src={studioPortrait} alt={`${site.founder.name}, arquitecto y director de Rizzoma`} width="1122" height="1402" fetchpriority="high" decoding="async" />
        <figcaption><span>{site.founder.name}</span><span>{site.founder.role}</span></figcaption>
      </figure>

      <div class="studio-profile-copy reveal">
        <p class="eyebrow">Arquitectura / Práctica independiente</p>
        <h2 class="large-copy" id="rz-studio-profile-title">El lugar, la materia y las personas como punto de partida.</h2>
        <p class="rz-studio-profile-intro">Con base en Medellín, Rizzoma reúne arquitectura y visualización bajo la dirección de Juan José Quintero Tobón, quien participa directamente en el desarrollo y la comunicación de cada encargo.</p>
        <blockquote class="rz-studio-voice">
          <p>Me interesa una arquitectura que comprenda el lugar antes de transformarlo. Una arquitectura en la que la luz, la materia, el paisaje y la vida cotidiana no sean elementos añadidos, sino parte de las decisiones que dan forma al espacio.</p>
          <p>Desde Rizzoma exploro esa relación a través del diseño y la visualización, entendiendo cada proyecto como una oportunidad para observar, interpretar y construir una respuesta propia.</p>
          <footer><span>{site.founder.name}</span><span>Dirección de Rizzoma</span></footer>
        </blockquote>
      </div>
    </section>

    <section class="values dark-block rz-studio-values" aria-labelledby="rz-studio-principles-title">
      <div class="section-pad">
        <div class="rz-studio-section-head reveal">
          <p class="eyebrow">Principios / La mirada del estudio</p>
          <h2 id="rz-studio-principles-title">Cuatro maneras de leer un proyecto.</h2>
        </div>
        <ol class="rz-studio-principles">
          <li class="reveal">
            <span class="rz-studio-principle-number">01</span>
            <div class="rz-studio-principle-text"><h3>Contexto</h3><p>Comprender la topografía, la orientación, el paisaje y las condiciones del lugar antes de definir cómo se implanta el proyecto.</p></div>
          </li>
          <li class="reveal">
            <span class="rz-studio-principle-number">02</span>
            <div class="rz-studio-principle-text"><h3>Habitar</h3><p>Estudiar las necesidades, los recorridos, los ritmos y las relaciones que construyen la experiencia cotidiana del espacio.</p></div>
          </li>
          <li class="reveal">
            <span class="rz-studio-principle-number">03</span>
            <div class="rz-studio-principle-text"><h3>Materia</h3><p>Trabajar con la luz, las texturas, los materiales y los detalles para dar carácter y atmósfera a cada lugar.</p></div>
          </li>
          <li class="reveal">
            <span class="rz-studio-principle-number">04</span>
            <div class="rz-studio-principle-text"><h3>Claridad</h3><p>Hacer comprensibles las decisiones arquitectónicas mediante dibujos, modelos y visualizaciones que expresen el proyecto con precisión.</p></div>
          </li>
        </ol>
      </div>
    </section>

    <section class="studio-capabilities section-pad rz-studio-representation" aria-labelledby="rz-studio-representation-title">
      <div class="rz-studio-representation-heading reveal">
        <p class="eyebrow">Diseño y visualización</p>
        <h2 id="rz-studio-representation-title">Pensar la arquitectura también es aprender a verla.</h2>
      </div>
      <div class="rz-studio-representation-copy reveal">
        <p class="rz-studio-representation-lead">La representación no es únicamente la imagen final de un proyecto. Es una herramienta para estudiar proporciones, explorar la luz, evaluar materialidades y comprender la atmósfera de un espacio mientras evoluciona.</p>
        <p>Observar distintas vistas de una misma propuesta permite poner atención en preguntas distintas: su relación con el entorno, la escala de los espacios o las cualidades de sus materiales. La imagen ayuda a comprender y comunicar las decisiones del proyecto.</p>
        <a class="text-link rz-studio-subtle-link" href={withBase('/servicios/')}>Conocer los servicios ↗</a>
      </div>
      {featuredProject?.gallery?.[2] && featuredProject?.gallery?.[4] && (
        <div class="rz-studio-visual-study" aria-label="Dos lecturas visuales de Casa Patio Horizonte">
          <div class="rz-studio-visual-study-head reveal">
            <p class="eyebrow">Dos vistas / Un mismo proyecto</p>
            <p>Casa Patio Horizonte. Su archivo visual permite observar decisiones del proyecto desde escalas distintas, sin presentar estas imágenes como etapas de trabajo.</p>
          </div>
          <div class="rz-studio-visual-pair">
            <figure class="rz-studio-visual-frame rz-studio-visual-frame--form reveal">
              <img src={featuredProject.gallery[2]} alt="Vista arquitectónica de Casa Patio Horizonte que permite observar los volúmenes y la relación de sus espacios" loading="lazy" decoding="async" />
              <figcaption><span>01 / Forma y escala</span><span>Casa Patio Horizonte</span></figcaption>
            </figure>
            <figure class="rz-studio-visual-frame rz-studio-visual-frame--material reveal">
              <img src={featuredProject.gallery[4]} alt="Vista de Casa Patio Horizonte que permite observar las cualidades espaciales y materiales del proyecto" loading="lazy" decoding="async" />
              <figcaption><span>02 / Espacio y materialidad</span><span>Casa Patio Horizonte</span></figcaption>
            </figure>
          </div>
          <p class="rz-studio-visual-study-footer">Dos representaciones de Casa Patio Horizonte, no una comparación de antes y después ni de fases de desarrollo.</p>
        </div>
      )}
    </section>

    {featuredProject?.cover && (
      <section class="studio-project-break" aria-labelledby="rz-studio-project-title">
        <div class="studio-project-image parallax-media">
          <img src={featuredProject.cover} alt={`${featuredProject.title}, vivienda concebida en relación con su paisaje`} loading="lazy" decoding="async" />
        </div>
        <div class="studio-project-caption section-pad">
          <p class="eyebrow reveal">Una mirada en proyecto / {featuredProject.location ?? 'Arquitectura'}</p>
          <div class="rz-studio-project-story reveal">
            <h2 id="rz-studio-project-title">{featuredProject.title}</h2>
            <p>En Casa Patio Horizonte, una decisión reconocible es articular patios, terrazas y aperturas para crear una transición gradual entre el interior y el exterior. Así, la luz y las vistas del entorno se incorporan a la experiencia cotidiana de la vivienda.</p>
            <a class="text-link" href={withBase(`/proyectos/${featuredProject.slug}/`)}>Explorar {featuredProject.title} ↗</a>
          </div>
        </div>
      </section>
    )}

    <section class="founder-cta dark-block rz-studio-contact" aria-labelledby="rz-studio-contact-title">
      <div class="section-pad founder-cta-inner rz-studio-contact-inner">
        <div class="rz-studio-contact-copy reveal">
          <p class="eyebrow">Del estudio al proyecto</p>
          <h2 id="rz-studio-contact-title">El diálogo también forma parte del diseño.</h2>
          <p>La conversación directa con Juan José permite poner en relación las necesidades del encargo, las condiciones del lugar y las decisiones que orientan el diseño o la visualización.</p>
        </div>
        <div class="rz-studio-contact-next reveal">
          <div class="rz-studio-contact-detail">
            <h3>El punto de partida</h3>
            <p>Puede ser un terreno, un espacio por transformar o un proyecto que necesita visualizarse. Lo importante es entender qué buscas resolver y en qué etapa te encuentras.</p>
          </div>
          <div class="rz-studio-contact-detail">
            <h3>Lo que ayuda a comprenderlo</h3>
            <p>La ubicación y los materiales disponibles —planos, fotografías, referencias o modelos— permiten situar la conversación y explorar un alcance adecuado. No necesitas tenerlo todo definido.</p>
          </div>
          <a class="rz-studio-contact-link" href={withBase('/contacto/')}>
            Hablar con Juan José <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>