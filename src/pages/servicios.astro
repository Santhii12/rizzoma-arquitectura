---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';
import '@/styles/servicios-editorial.css';

const baseSite = Astro.site ?? new URL(site.domain);
const servicesUrl = new URL(withBase('/servicios/'), baseSite).toString();
const cover = withBase('/images/studio/home/rizzoma-hero-portada.webp');
const coverAbsoluteUrl = new URL(cover, baseSite).toString();
const serviceLines = [
  {
    id: 'arquitectura',
    number: '01',
    name: 'Desarrollo arquitectónico',
    title: 'Comprender el lugar. Dar forma al proyecto.',
    summary: 'Apoyo en conceptualización, implantación y diseño arquitectónico, según la etapa y las necesidades del encargo.',
    description: 'La orientación, la topografía, el uso y las condiciones del lugar guían el estudio de alternativas y la organización de los espacios. Rizzoma puede colaborar con otros arquitectos en tareas acordadas o desarrollar propuestas propias.',
    services: [
      'Conceptualización arquitectónica.',
      'Estudios de implantación y relación con el entorno.',
      'Diseño y desarrollo de propuestas arquitectónicas según alcance.'
    ],
    startingPoint: 'Cuéntanos la etapa del proyecto, su ubicación, el programa y las tareas para las que buscas apoyo. No es necesario tener todos los insumos desde el primer contacto.',
    ctaLabel: 'Consultar desarrollo arquitectónico',
    contactMessage: 'Hola, Juan José. Soy arquitecto/a o represento un estudio y quisiera conversar sobre apoyo externo en desarrollo arquitectónico. ¿Podemos revisar el alcance de mi proyecto?',
    image: withBase('/images/services/diseno-arquitectonico-casa.jpg'),
    alt: 'Propuesta residencial representada en una visualización arquitectónica del archivo de Rizzoma',
    caption: 'Propuesta residencial / Diseño y representación de Rizzoma',
    relatedLink: withBase('/proyectos/casa-patio-horizonte/'),
    relatedLabel: 'Explorar Casa Patio Horizonte',
    imageWidth: 1122,
    imageHeight: 1402,
    featured: true
  },
  {
    id: 'modelado',
    number: '02',
    name: 'Modelado y documentación arquitectónica',
    title: 'Representar con claridad lo que se proyecta.',
    summary: 'Modelos tridimensionales, plantas y dibujos arquitectónicos de acuerdo con los materiales recibidos y el alcance contratado.',
    description: 'Los modelos y dibujos ayudan a estudiar volumetrías, relaciones espaciales y decisiones de diseño. Cada entrega se define con el arquitecto responsable; no se ofrece aquí documentación técnica integral ni ingeniería especializada.',
    services: [
      'Modelos tridimensionales de arquitectura.',
      'Plantas y dibujos arquitectónicos según alcance.',
      'Apoyo gráfico para estudiar y presentar alternativas.'
    ],
    startingPoint: 'Comparte planos, croquis, referencias, levantamientos disponibles o un modelo existente. Con esa base definimos formato, nivel de desarrollo y entregables.',
    ctaLabel: 'Consultar modelado y planos',
    contactMessage: 'Hola, Juan José. Quisiera conversar sobre una colaboración de modelado 3D y planos arquitectónicos según el alcance de mi proyecto.',
    image: withBase('/images/projects/casa-el-santuario/archivo/planta.webp'),
    alt: 'Planta arquitectónica de Casa El Santuario con distribución de los espacios',
    caption: 'Casa El Santuario / Planta arquitectónica',
    relatedLink: withBase('/proyectos/casa-el-santuario/'),
    relatedLabel: 'Explorar Casa El Santuario',
    imageWidth: 1448,
    imageHeight: 814,
    featured: false
  },
  {
    id: 'visualizacion',
    number: '03',
    name: 'Visualización arquitectónica',
    title: 'Hacer visible la intención del diseño.',
    summary: 'Renders e imágenes para presentaciones de diseño y comunicación comercial de proyectos propios o de otros estudios.',
    description: 'La representación ayuda a expresar fachadas, materialidad, atmósferas y relación con el paisaje. El trabajo de Cabo San Miguel documenta específicamente diseño de fachada, modelado y visualización comercial, sin atribuir a Rizzoma el diseño integral del edificio.',
    services: [
      'Renders de arquitectura interior y exterior.',
      'Imágenes para presentaciones de diseño.',
      'Visualización de fachada y comunicación comercial.'
    ],
    startingPoint: 'Planos, modelos, fotografías del sitio y referencias permiten definir vistas, alcance y entregables. También podemos revisar el material disponible antes de proponer una solución.',
    ctaLabel: 'Consultar visualización',
    contactMessage: 'Hola, Juan José. Quisiera solicitar visualizaciones arquitectónicas para un proyecto. ¿Podemos revisar vistas, referencias y entregables?',
    image: withBase('/images/projects/cabo-san-miguel/exteriores-07.webp'),
    alt: 'Cabo San Miguel, visualización del edificio en Guatapé y su fachada desarrollada por Rizzoma',
    caption: 'Cabo San Miguel / Fachada y visualización comercial',
    relatedLink: withBase('/proyectos/cabo-san-miguel/'),
    relatedLabel: 'Explorar Cabo San Miguel',
    imageWidth: 1920,
    imageHeight: 1080,
    featured: false
  }
] as const;

const serviceContactUrl = (message: string) => `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(message)}`;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${servicesUrl}#page`,
    name: 'Servicios de Rizzoma Arquitectura',
    url: servicesUrl,
    description: 'Desarrollo, modelado y documentación, y visualización arquitectónica: apoyo externo a estudios y encargos propios según alcance.',
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` }
  },
  {
    '@type': 'ItemList',
    name: 'Líneas de trabajo de Rizzoma',
    itemListElement: serviceLines.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: service.name,
      url: `${servicesUrl}#${service.id}`
    }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: servicesUrl }
    ]
  }
];
---
<BaseLayout
  title="Colaboraciones y servicios de arquitectura en Medellín | Rizzoma"
  description="Apoyo a arquitectos y estudios en desarrollo arquitectónico, modelado 3D, planos según alcance y visualización. Rizzoma, práctica independiente en Medellín."
  schema={schema}
  image={coverAbsoluteUrl}
  imageAlt="Arquitectura contemporánea de Casa Patio Horizonte, archivo de Rizzoma"
>
  <header class="rz-services-guide__hero" aria-labelledby="rz-services-page-title">
    <div class="rz-services-guide__hero-inner">
      <div class="rz-services-guide__hero-heading">
        <p class="rz-services-guide__label">Rizzoma / Servicios</p>
        <h1 id="rz-services-page-title">Colaborar desde <em>el proyecto.</em></h1>
      </div>
      <div class="rz-services-guide__hero-intro">
        <p class="rz-services-guide__lead">Apoyo externo para arquitectos y estudios. También proyectos propios.</p>
        <p>Desarrollo arquitectónico, modelado y documentación, y visualización. Juan José participa directamente en cada encargo; tareas, responsabilidades y entregables se acuerdan según la necesidad del proyecto.</p>
      </div>
    </div>
    <nav class="rz-services-guide__index" aria-label="Ir a cada servicio">
      {serviceLines.map((service) => (
        <a href={`#${service.id}`}>
          <span>{service.number}</span>
          <span>{service.name}</span>
          <span aria-hidden="true">↗︎</span>
        </a>
      ))}
    </nav>
  </header>

  <div class="rz-services-guide__chapters">
    {serviceLines.map((service) => (
      <section
        id={service.id}
        class:list={['rz-services-guide__chapter', { 'rz-services-guide__chapter--featured': service.featured }]}
        aria-labelledby={`rz-services-guide-${service.id}-title`}
      >
        <figure class="rz-services-guide__media">
          <img
            src={service.image}
            alt={service.alt}
            width={service.imageWidth}
            height={service.imageHeight}
            loading={service.featured ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{service.caption}</figcaption>
        </figure>
        <div class="rz-services-guide__content">
          <div class="rz-services-guide__chapter-meta">
            <span>{service.number} / 03</span>
            <span>{service.featured ? 'Servicio destacado / Rizzoma' : 'Servicios / Rizzoma'}</span>
          </div>
          <h2 id={`rz-services-guide-${service.id}-title`}>{service.name}</h2>
          <p class="rz-services-guide__concept">{service.title}</p>
          <p class="rz-services-guide__summary">{service.summary}</p>
          <p class="rz-services-guide__description">{service.description}</p>
          <a class="rz-services-guide__chapter-action" href={serviceContactUrl(service.contactMessage)} target="_blank" rel="noopener noreferrer" aria-label={`${service.ctaLabel} por WhatsApp, se abre en una pestaña nueva`}>
            {service.ctaLabel}<span aria-hidden="true">↗︎</span>
          </a>
          <a class="rz-services-guide__case-link" href={service.relatedLink}>
            <span>Ver un proyecto de Rizzoma</span>
            <strong>{service.relatedLabel}</strong>
            <span aria-hidden="true">↗︎</span>
          </a>
          {service.id === 'visualizacion' && <span id="diseno-visualizacion" class="rz-services-guide__anchor" aria-hidden="true"></span>}
          {service.id === 'arquitectura' && <span id="remodelacion" class="rz-services-guide__anchor" aria-hidden="true"></span>}
          <div class="rz-services-guide__details">
            <div>
              <h3>Qué podemos desarrollar</h3>
              <ul>
                {service.services.map((entry) => <li>{entry}</li>)}
              </ul>
            </div>
            <div>
              <h3>Por dónde empezar</h3>
              <p>{service.startingPoint}</p>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="rz-services-guide__method" aria-labelledby="rz-services-guide-method-title">
    <div class="rz-services-guide__method-inner">
      <div class="rz-services-guide__method-intro">
        <p class="rz-services-guide__label">Cómo empezamos</p>
        <h2 id="rz-services-guide-method-title">Un punto de partida claro.</h2>
        <p>Antes de definir el trabajo, revisamos qué necesita el proyecto, qué materiales existen y qué corresponde asumir a cada parte. La primera conversación es directamente con Juan José Quintero Tobón, quien dirige Rizzoma.</p>
      </div>
      <ol class="rz-services-guide__method-steps" aria-label="Información para comenzar un proyecto">
        <li>
          <span class="rz-services-guide__step-number" aria-hidden="true">01</span>
          <div>
            <h3>Cuéntanos qué necesitas</h3>
            <p>Indica si buscas colaboración en desarrollo, modelado y planos o visualización; señala la ubicación y la etapa del proyecto.</p>
          </div>
        </li>
        <li>
          <span class="rz-services-guide__step-number" aria-hidden="true">02</span>
          <div>
            <h3>Comparte lo que tengas</h3>
            <p>Planos, modelos 3D, fotografías o referencias ayudan a comprender el encargo. Si aún no tienes esos materiales, puedes empezar con una descripción.</p>
          </div>
        </li>
        <li>
          <span class="rz-services-guide__step-number" aria-hidden="true">03</span>
          <div>
            <h3>Concretemos el alcance</h3>
            <p>Con esa información podemos conversar sobre las tareas, los entregables necesarios y una propuesta acorde con el proyecto.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="rz-services-guide__contact" aria-labelledby="rz-services-guide-contact-title">
    <div class="rz-services-guide__contact-inner">
      <div class="rz-services-guide__contact-heading">
        <p class="rz-services-guide__label">Contacto directo</p>
        <h2 id="rz-services-guide-contact-title">Hablemos de lo que tienes en mente.</h2>
      </div>
      <div class="rz-services-guide__contact-details">
        <p>No hace falta tener una propuesta terminada. Cuéntanos qué tipo de trabajo necesitas y comparte la información disponible. Desde ahí podemos definir el siguiente paso.</p>
        <a href={withBase('/contacto/')} class="rz-services-guide__contact-link">
          Hablemos de tu proyecto <span aria-hidden="true">↗︎</span>
        </a>
        <p class="rz-services-guide__contact-note">El contacto es con Juan José, responsable del estudio.</p>
      </div>
    </div>
  </section>
</BaseLayout>
