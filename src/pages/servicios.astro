---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';

const baseSite = Astro.site ?? new URL(site.domain);
const servicesUrl = new URL(withBase('/servicios/'), baseSite).toString();
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${servicesUrl}#page`,
    name: 'Servicios de Rizzoma Arquitectura',
    url: servicesUrl,
    description: 'Visualización arquitectónica, diseño arquitectónico e interiores y remodelación desde Medellín.',
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` }
  },
  {
    '@type': 'ItemList',
    name: 'Servicios de Rizzoma Arquitectura',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Visualización arquitectónica',
        url: new URL(withBase('/visualizacion-arquitectonica-medellin/'), baseSite).toString()
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Diseño arquitectónico',
        url: new URL(withBase('/arquitectura-medellin/'), baseSite).toString()
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Diseño y remodelación de interiores',
        url: servicesUrl + '#interiores'
      }
    ]
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: servicesUrl }
    ]
  }
];
---
<BaseLayout
  title="Servicios de arquitectura y visualización | Rizzoma"
  description="Visualización arquitectónica, diseño arquitectónico, interiores y remodelación con interlocución directa de Juan José Quintero Tobón."
  schema={schema}
>
  <section class="page-hero section-pad rizzoma-services-page-hero">
    <p class="eyebrow reveal">Servicios</p>
    <h1 class="page-title reveal">Diseñar, entender<br />y comunicar.</h1>
    <p class="page-intro reveal">Rizzoma trabaja la arquitectura y su representación como partes de una misma conversación. El alcance cambia según lo que necesite cada encargo.</p>
  </section>

  <section id="visualizacion" class="rizzoma-service-primary section-pad no-top">
    <div class="rizzoma-service-primary-number reveal">01 / Servicio principal</div>
    <div class="rizzoma-service-primary-copy reveal">
      <p class="service-kicker">Hacer visible lo que aún no existe</p>
      <h2>Visualización arquitectónica</h2>
      <p class="rizzoma-service-lede">Imágenes para comprender, evaluar y comunicar arquitectura con criterio espacial, material y atmosférico.</p>
      <p>Rizzoma puede acompañar proyectos propios o desarrollados por arquitectos, oficinas, constructoras y otros profesionales que necesitan presentar una propuesta con claridad sin separar la imagen del pensamiento arquitectónico.</p>
      <ul>
        <li>Renders exteriores</li>
        <li>Renders interiores</li>
        <li>Modelado 3D</li>
        <li>Materialidad y atmósfera</li>
        <li>Dirección de encuadres</li>
        <li>Imágenes para presentación</li>
      </ul>
      <div class="rizzoma-service-actions">
        <a class="primary-link" href={withBase('/visualizacion-arquitectonica-medellin/')}>Conocer visualización <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={withBase('/contacto/?servicio=Visualizaci%C3%B3n%20arquitect%C3%B3nica')}>Solicitar una conversación ↗</a>
      </div>
    </div>
  </section>

  <section class="rizzoma-services-pair section-pad">
    <article id="arquitectura" class="rizzoma-service-column reveal">
      <span>02</span>
      <p class="service-kicker">Lugar · espacio · habitar</p>
      <h2>Diseño arquitectónico</h2>
      <p>Propuestas que parten de las condiciones del lugar, las necesidades del encargo y la experiencia cotidiana de quienes van a habitarlo.</p>
      <ul>
        <li>Vivienda</li>
        <li>Conceptualización</li>
        <li>Organización espacial</li>
        <li>Modelado y desarrollo gráfico</li>
      </ul>
      <a class="text-link" href={withBase('/arquitectura-medellin/')}>Conocer arquitectura ↗</a>
    </article>

    <article id="interiores" class="rizzoma-service-column reveal">
      <span>03</span>
      <p class="service-kicker">Transformar lo existente</p>
      <h2>Interiores + remodelación</h2>
      <p>Lectura y transformación de espacios existentes desde el uso, la luz, los recorridos, los materiales y la atmósfera que se quiere construir.</p>
      <ul>
        <li>Redistribución espacial</li>
        <li>Concepto de interiores</li>
        <li>Materialidad</li>
        <li>Visualización de la propuesta</li>
      </ul>
      <a class="text-link" href={withBase('/contacto/?servicio=Dise%C3%B1o%20y%20remodelaci%C3%B3n%20de%20interiores')}>Consultar un proyecto ↗</a>
    </article>
  </section>

  <section class="rizzoma-service-method dark-block">
    <div class="section-pad">
      <p class="eyebrow reveal">Una misma lógica</p>
      <div class="rizzoma-service-method-grid">
        <h2 class="reveal">Diseñar y visualizar no son dos mundos separados.</h2>
        <div class="reveal">
          <p>La representación permite comprobar escala, luz, materialidad y atmósfera mientras el proyecto evoluciona. Por eso puede formar parte del diseño o funcionar como un servicio independiente cuando el proyecto ya existe.</p>
          <p>En ambos casos, la intención es la misma: hacer comprensibles las decisiones arquitectónicas.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="rizzoma-service-start section-pad">
    <p class="eyebrow reveal">Para empezar</p>
    <h2 class="reveal">No necesitas tenerlo todo resuelto.</h2>
    <p class="reveal">Planos, un modelo, referencias, información del lugar o incluso una idea inicial pueden ser suficiente para entender el punto de partida y definir el alcance.</p>
    <a class="primary-link reveal" href={withBase('/contacto/')}>Conversar con Juan José <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
