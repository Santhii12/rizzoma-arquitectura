---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';
import '@/styles/servicios-editorial.css';

const baseSite = Astro.site ?? new URL(site.domain);
const servicesUrl = new URL(withBase('/servicios/'), baseSite).toString();
const cover = withBase('/images/studio/home/rizzoma-hero-portada.webp');
const coverAbsoluteUrl = new URL(cover, baseSite).toString();
const serviceLines = [
  {
    id: 'visualizacion',
    number: '01',
    name: 'Visualización arquitectónica',
    title: 'Arquitectura que se puede imaginar.',
    summary: 'Creamos imágenes y recorridos que permiten comprender el proyecto, explorar su atmósfera y comunicar su intención antes de construirlo.',
    description: 'La luz, las proporciones y los materiales se hacen visibles para estudiar decisiones de diseño y presentar propuestas propias o de otros estudios.',
    services: [
      'Renders de interiores y exteriores.',
      'Animación arquitectónica.',
      'Recorridos virtuales.',
      'Imágenes 360°.',
      'Modelado para visualización.'
    ],
    startingPoint: 'Planos, modelos 3D, referencias o fotografías del lugar. El alcance y los entregables se definen según las necesidades de cada proyecto.',
    ctaLabel: 'Solicitar una propuesta',
    contactMessage: 'Hola, quisiera solicitar una propuesta de visualización arquitectónica. ¿Podemos conversar sobre mi proyecto y el material necesario?',
    image: withBase('/images/projects/cabo-san-miguel/exteriores-04.webp'),
    alt: 'Cabo San Miguel, edificio de vivienda junto al embalse de Guatapé, con diseño de fachada, modelado y visualización comercial realizados por Rizzoma',
    caption: 'Cabo San Miguel / Diseño de fachada y visualización comercial · Rizzoma',
    relatedLink: withBase('/proyectos/cabo-san-miguel/'),
    relatedLabel: 'Explorar Cabo San Miguel',
    imageWidth: 1920,
    imageHeight: 1080,
    featured: true
  },
  {
    id: 'arquitectura',
    number: '02',
    name: 'Diseño arquitectónico',
    title: 'Espacios con sentido.',
    summary: 'Diseñamos espacios a partir del lugar, de quienes los habitan y de la relación entre luz, materia y uso cotidiano.',
    description: 'El contexto, las condiciones del terreno y la manera de habitar orientan la organización espacial. Cada decisión busca dar coherencia a la propuesta.',
    services: [
      'Diseño de vivienda.',
      'Diseño conceptual.',
      'Desarrollo arquitectónico.'
    ],
    startingPoint: 'Una idea, la ubicación y las necesidades principales. Si existen planos, información del lote o referencias, ayudan a definir la etapa del proyecto.',
    ctaLabel: 'Consultar diseño arquitectónico',
    contactMessage: 'Hola, quisiera conversar sobre un proyecto de diseño arquitectónico. ¿Qué información necesitan para empezar?',
    image: withBase('/images/services/diseno-arquitectonico-casa.jpg'),
    alt: 'Visualización exterior de casa contemporánea con fachadas de madera y vidrio, rodeada de vegetación al atardecer',
    caption: 'Diseño arquitectónico / Obra visual de Rizzoma',
    relatedLink: withBase('/proyectos/casa-patio-horizonte/'),
    relatedLabel: 'Explorar Casa Patio Horizonte',
    imageWidth: 1122,
    imageHeight: 1402,
    featured: false
  },
  {
    id: 'remodelacion',
    number: '03',
    name: 'Remodelación y transformación de espacios',
    title: 'Lo existente, de otra manera.',
    summary: 'Exploramos cómo transformar un espacio existente para mejorar su funcionamiento, su atmósfera y su relación con los materiales.',
    description: 'Partimos de lo que merece permanecer y de lo que necesita cambiar: recorridos, luz, distribución y acabados. La intervención se plantea según el estado y el uso del lugar.',
    services: [
      'Remodelaciones residenciales.',
      'Diseño interior.',
      'Actualización de espacios comerciales.'
    ],
    startingPoint: 'Fotografías, medidas o planos del estado actual y una breve descripción de los cambios deseados.',
    ctaLabel: 'Consultar una remodelación',
    contactMessage: 'Hola, quisiera conversar sobre la remodelación de un espacio. Tengo algunas referencias y me gustaría conocer cómo empezar.',
    image: withBase('/images/services/remodelacion-interior.jpg'),
    alt: 'Interior de sala residencial con sofá claro, mesa de centro, cocina abierta y escalera de madera',
    caption: 'Interior residencial / Diseño y visualización de Rizzoma',
    relatedLink: withBase('/proyectos/casa-el-umbral/'),
    relatedLabel: 'Explorar interiores de Casa El Umbral',
    imageWidth: 1448,
    imageHeight: 814,
    featured: false
  }
] as const;

const serviceContactUrl = (message: string) => `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(message)}`;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${servicesUrl}#page`,
    name: 'Servicios de Rizzoma Arquitectura',
    url: servicesUrl,
    description: 'Visualización arquitectónica, diseño arquitectónico y remodelación: tres maneras de dar forma y comunicar la arquitectura en Rizzoma.',
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` }
  },
  {
    '@type': 'ItemList',
    name: 'Líneas de trabajo de Rizzoma',
    itemListElement: serviceLines.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: service.name,
      url: `${servicesUrl}#${service.id}`
    }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: servicesUrl }
    ]
  }
];
---
<BaseLayout
  title="Servicios de arquitectura, renders y remodelación en Medellín | Rizzoma"
  description="Conoce las tres líneas de Rizzoma: visualización arquitectónica y renders, diseño arquitectónico y remodelación de espacios. Estudio independiente en Medellín."
  schema={schema}
  image={coverAbsoluteUrl}
  imageAlt="Arquitectura contemporánea de Casa Patio Horizonte, archivo de Rizzoma"
>
  <header class="rz-services-guide__hero" aria-labelledby="rz-services-page-title">
    <div class="rz-services-guide__hero-inner">
      <div class="rz-services-guide__hero-heading">
        <p class="rz-services-guide__label">Rizzoma / Servicios</p>
        <h1 id="rz-services-page-title">Del espacio <em>a la imagen.</em></h1>
      </div>
      <div class="rz-services-guide__hero-intro">
        <p class="rz-services-guide__lead">Cada proyecto pide una mirada propia.</p>
        <p>Visualización arquitectónica, diseño y transformación de espacios. Tres maneras de trabajar con el lugar, la luz y la materialidad, desde una práctica independiente.</p>
      </div>
    </div>
    <nav class="rz-services-guide__index" aria-label="Ir a cada servicio">
      {serviceLines.map((service) => (
        <a href={`#${service.id}`}>
          <span>{service.number}</span>
          <span>{service.name}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </header>

  <div class="rz-services-guide__chapters">
    {serviceLines.map((service) => (
      <section
        id={service.id}
        class:list={['rz-services-guide__chapter', { 'rz-services-guide__chapter--featured': service.featured }]}
        aria-labelledby={`rz-services-guide-${service.id}-title`}
      >
        <figure class="rz-services-guide__media">
          <img
            src={service.image}
            alt={service.alt}
            width={service.imageWidth}
            height={service.imageHeight}
            loading={service.featured ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{service.caption}</figcaption>
        </figure>
        <div class="rz-services-guide__content">
          <div class="rz-services-guide__chapter-meta">
            <span>{service.number} / 03</span>
            <span>{service.featured ? 'Servicio destacado / Rizzoma' : 'Servicios / Rizzoma'}</span>
          </div>
          <h2 id={`rz-services-guide-${service.id}-title`}>{service.name}</h2>
          <p class="rz-services-guide__concept">{service.title}</p>
          <p class="rz-services-guide__summary">{service.summary}</p>
          <p class="rz-services-guide__description">{service.description}</p>
          <a class="rz-services-guide__chapter-action" href={serviceContactUrl(service.contactMessage)} target="_blank" rel="noopener noreferrer" aria-label={`${service.ctaLabel} por WhatsApp, se abre en una pestaña nueva`}>
            {service.ctaLabel}<span aria-hidden="true">↗</span>
          </a>
          <a class="rz-services-guide__case-link" href={service.relatedLink}>
            <span>Ver un proyecto de Rizzoma</span>
            <strong>{service.relatedLabel}</strong>
            <span aria-hidden="true">↗</span>
          </a>
          {service.id === 'visualizacion' && <span id="diseno-visualizacion" class="rz-services-guide__anchor" aria-hidden="true"></span>}
          <div class="rz-services-guide__details">
            <div>
              <h3>Qué podemos desarrollar</h3>
              <ul>
                {service.services.map((entry) => <li>{entry}</li>)}
              </ul>
            </div>
            <div>
              <h3>Por dónde empezar</h3>
              <p>{service.startingPoint}</p>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="rz-services-guide__method" aria-labelledby="rz-services-guide-method-title">
    <div class="rz-services-guide__method-inner">
      <div class="rz-services-guide__method-intro">
        <p class="rz-services-guide__label">Cómo empezamos</p>
        <h2 id="rz-services-guide-method-title">Un punto de partida claro.</h2>
        <p>Antes de definir un servicio, necesitamos entender el lugar, la etapa del proyecto y lo que buscas resolver. La primera conversación es directamente con Juan José Quintero Tobón, quien dirige Rizzoma.</p>
      </div>
      <ol class="rz-services-guide__method-steps" aria-label="Información para comenzar un proyecto">
        <li>
          <span class="rz-services-guide__step-number" aria-hidden="true">01</span>
          <div>
            <h3>Cuéntanos qué necesitas</h3>
            <p>Indica si buscas visualización, diseño o remodelación, dónde se encuentra el proyecto y en qué etapa está.</p>
          </div>
        </li>
        <li>
          <span class="rz-services-guide__step-number" aria-hidden="true">02</span>
          <div>
            <h3>Comparte lo que tengas</h3>
            <p>Planos, modelos 3D, fotografías o referencias ayudan a comprender el encargo. Si aún no tienes esos materiales, puedes empezar con una descripción.</p>
          </div>
        </li>
        <li>
          <span class="rz-services-guide__step-number" aria-hidden="true">03</span>
          <div>
            <h3>Concretemos el alcance</h3>
            <p>Con esa información podemos conversar sobre las tareas, los entregables necesarios y una propuesta acorde con el proyecto.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="rz-services-guide__contact" aria-labelledby="rz-services-guide-contact-title">
    <div class="rz-services-guide__contact-inner">
      <div class="rz-services-guide__contact-heading">
        <p class="rz-services-guide__label">Contacto directo</p>
        <h2 id="rz-services-guide-contact-title">Hablemos de lo que tienes en mente.</h2>
      </div>
      <div class="rz-services-guide__contact-details">
        <p>No hace falta tener una propuesta terminada. Cuéntanos qué tipo de trabajo necesitas y comparte la información disponible. Desde ahí podemos definir el siguiente paso.</p>
        <a href={withBase('/contacto/')} class="rz-services-guide__contact-link">
          Hablemos de tu proyecto <span aria-hidden="true">↗</span>
        </a>
        <p class="rz-services-guide__contact-note">El contacto es con Juan José, responsable del estudio.</p>
      </div>
    </div>
  </section>
</BaseLayout>
