---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';

const baseSite = Astro.site ?? new URL(site.domain);
const pageUrl = new URL(withBase('/contacto/'), baseSite).toString();
const contactFaq = [
  ['¿Puedo contratar únicamente visualización?', 'Sí. Rizzoma puede trabajar visualización arquitectónica como servicio independiente a partir de planos, modelos, referencias o un proyecto desarrollado por otro equipo.'],
  ['¿Puedo llegar solo con una idea?', 'Sí. Para una primera conversación basta con explicar qué quieres resolver, dónde está el proyecto y en qué etapa se encuentra.'],
  ['¿Qué ayuda a definir el alcance?', 'El objetivo del encargo, la ubicación y el material disponible permiten entender el punto de partida. Si falta información, se identifica antes de avanzar.']
] as const;

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${pageUrl}#page`,
    name: 'Contacto — Rizzoma Arquitectura',
    url: pageUrl,
    description: 'Contacto directo con Rizzoma Arquitectura para visualización arquitectónica, diseño arquitectónico e interiores.',
    isPartOf: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#website` },
    about: { '@id': `${baseSite.toString().replace(/\/$/, '')}/#business` }
  },
  {
    '@type': 'FAQPage',
    mainEntity: contactFaq.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer }
    }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), baseSite).toString() },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title="Contacto | Rizzoma Arquitectura"
  description="Habla directamente con Juan José Quintero Tobón sobre visualización arquitectónica, diseño arquitectónico o interiores."
  schema={schema}
>
  <section class="rizzoma-contact section-pad">
    <div class="rizzoma-contact-intro">
      <p class="eyebrow reveal">Contacto</p>
      <h1 class="page-title reveal">Cuéntanos<br />qué necesitas.</h1>
      <p class="page-intro reveal">La primera conversación es directamente con Juan José. El objetivo es entender el proyecto, su etapa y qué puede aportar Rizzoma antes de definir un alcance.</p>

      <div class="rizzoma-contact-intents reveal">
        <a href="?servicio=Visualizaci%C3%B3n%20arquitect%C3%B3nica#formulario">
          <span>01</span>
          <strong>Necesito visualizar un proyecto</strong>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="?servicio=Dise%C3%B1o%20arquitect%C3%B3nico#formulario">
          <span>02</span>
          <strong>Quiero desarrollar un proyecto</strong>
          <b aria-hidden="true">↗</b>
        </a>
      </div>

      <div class="contact-direct reveal">
        <a href={site.whatsappUrl} target="_blank" rel="noreferrer"><span>WhatsApp</span><strong>+57 315 741 4871 ↗</strong></a>
        <a href={`mailto:${site.email}`}><span>Correo</span><strong>{site.email} ↗</strong></a>
        <a href={site.instagramUrl} target="_blank" rel="noreferrer"><span>Instagram</span><strong>{site.instagramHandle} ↗</strong></a>
      </div>
    </div>

    <form id="formulario" class="contact-form rizzoma-contact-form reveal" data-contact-form data-whatsapp={site.whatsappNumber} autocomplete="on">
      <div class="rizzoma-contact-form-head">
        <p class="eyebrow">Brief inicial</p>
        <p>Solo necesitamos la información suficiente para saber cómo empezar.</p>
      </div>

      <div class="form-honeypot" aria-hidden="true">
        <label>Empresa<input name="empresa_web" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label><span>Nombre *</span><input name="nombre" type="text" autocomplete="name" required minlength="2" maxlength="80" placeholder="Tu nombre" /></label>
      <label><span>Correo *</span><input name="email" type="email" autocomplete="email" required maxlength="160" placeholder="tu@correo.com" /></label>
      <label><span>WhatsApp</span><input name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" pattern="[0-9+() .-]{7,24}" placeholder="+57 ..." /></label>

      <label>
        <span>¿Qué necesitas? *</span>
        <select name="servicio" required data-service-select>
          <option value="">Selecciona una opción</option>
          <option>Visualización arquitectónica</option>
          <option>Diseño arquitectónico</option>
          <option>Diseño y remodelación de interiores</option>
          <option>Otro</option>
        </select>
      </label>

      <label class="full"><span>Ubicación del proyecto</span><input name="ubicacion" type="text" maxlength="120" placeholder="Ciudad / municipio" /></label>
      <label class="full"><span>Cuéntanos brevemente sobre el proyecto *</span><textarea name="mensaje" rows="5" required minlength="10" maxlength="1800" placeholder="¿Qué tienes, qué necesitas y en qué etapa estás?"></textarea></label>

      <label class="consent full"><input name="privacidad" type="checkbox" required /><span>Acepto que Rizzoma use estos datos únicamente para responder mi solicitud. <a href={withBase('/privacidad/')}>Ver privacidad.</a></span></label>
      <button class="submit-button" type="submit">Continuar por WhatsApp <span aria-hidden="true">↗</span></button>
      <p class="form-note" data-form-note>Se abrirá WhatsApp con el mensaje preparado. Tú decides si lo envías.</p>
    </form>

    <noscript><p class="form-note">Si tienes JavaScript desactivado, puedes escribir directamente a <a href={`mailto:${site.email}`}>{site.email}</a> o abrir <a href={site.whatsappUrl}>WhatsApp</a>.</p></noscript>
  </section>

  <section class="rizzoma-contact-faq dark-block">
    <div class="section-pad">
      <div class="rizzoma-contact-faq-head reveal">
        <p class="eyebrow">Antes de empezar</p>
        <h2>Lo esencial, sin vueltas.</h2>
      </div>
      <div class="faq-list">
        {contactFaq.map(([question, answer]) => (
          <details class="reveal"><summary>{question}<span>+</span></summary><p>{answer}</p></details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
