---
import type { Project, ProjectImage } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/project-editorial.css';

interface Props {
  project: Project;
  index: number;
  total: number;
  nextProject?: Project;
}

const { project, index, total, nextProject } = Astro.props;
const pad = (index: number) => String(index).padStart(2, '0');
const tour = (project.tour ?? []).filter((group) => group.images?.length > 0);
const insights = (project.sections ?? []).filter((item) => item.title && item.text);
const archive = (project.archive ?? []).filter((group) => group.images?.length > 0);
const heroSlides: ProjectImage[] = (project.gallery?.length ? project.gallery : (project.cover ? [project.cover] : [])).map((src, i) => ({
  src,
  alt: i === 0 ? (project.coverAlt ?? `Imagen principal de ${project.title}`) : `Vista ${i + 1} del proyecto ${project.title}`,
  caption: project.title
}));
const hasCarousel = heroSlides.length > 1;
// Exclude images already used in the opening carousel. Other tour groups
// can still render independently (e.g. Cabo San Miguel's interior gallery).
const visibleTour = tour.map((group) => ({
  ...group,
  images: group.images.filter((image) => !heroSlides.some((slide) => slide.src === image.src))
})).filter((group) => group.images.length > 0);
const hasGallery = visibleTour.length > 0;
const hasInsights = insights.length > 0;
const hasArchive = archive.length > 0;
const heroAlt = project.coverAlt ?? `Imagen principal de ${project.title}`;
const location = [project.location, project.region].filter(Boolean).join(', ');
const hasFacts = !!(project.typology || project.category || project.participation || location || project.year);
const allVisuals: ProjectImage[] = [
  ...heroSlides,
  ...visibleTour.flatMap((group) => group.images),
  ...insights.flatMap((section) => section.image ? [section.image] : []),
  ...archive.flatMap((group) => group.images)
].filter((visual, index, all) => all.findIndex((item) => item.src === visual.src) === index);
---
<article class="rz-pe" aria-labelledby="rz-pe-title">
  <header class="rz-pe__opening section-pad">
    <div class="rz-pe__topline">
      <a href={withBase('/portafolio/')} class="rz-pe__back">← Volver al portafolio</a>
      <span aria-label={`Proyecto ${index + 1} de ${total} proyectos publicados`}>{pad(index + 1)} / {pad(total)}</span>
    </div>
    <div class="rz-pe__intro-grid">
      <div class="rz-pe__headline">
        <p class="rz-pe__eyebrow">Rizzoma / Proyecto seleccionado</p>
        <h1 id="rz-pe-title">{project.title}</h1>
      </div>
      <div class="rz-pe__opening-aside">
        {project.statement && <p class="rz-pe__statement">{project.statement}</p>}
        <p class="rz-pe__discipline">{project.category}</p>
      </div>
    </div>
    {(location || project.year) && (
      <div class="rz-pe__header-meta">
        {location && <span>{location}</span>}
        {project.year && <span>{project.year}</span>}
      </div>
    )}
  </header>

  {project.cover && (
    <section class="rz-pe__hero-section section-pad no-top" aria-label={`Galería principal de ${project.title}`}>
      <figure class="rz-pe__hero">
        {project.galleryLabel && <p class="rz-pe__gallery-label">{project.galleryLabel}</p>}
        <div class="rz-pe__hero-stage" data-pe-gallery={JSON.stringify(heroSlides)}>
          <button
            class="rz-pe__image-trigger rz-pe__hero-trigger"
            type="button"
            data-editorial-image
            data-full-src={project.cover}
            data-full-alt={heroAlt}
            data-full-caption={project.title}
            aria-label={`Ampliar imagen principal de ${project.title}`}
          >
            <img src={project.cover} alt={heroAlt} data-pe-hero-img fetchpriority="high" decoding="async" />
            <span class="rz-pe__zoom-indicator" aria-hidden="true">Ampliar ↗</span>
          </button>
          {hasCarousel && (
            <div class="rz-pe__carousel-controls" aria-label="Controles de galería principal">
              <span data-pe-slide-counter aria-live="polite">01 / {pad(heroSlides.length)}</span>
              <button type="button" data-pe-prev aria-label="Imagen anterior">←</button>
              <button type="button" data-pe-next aria-label="Imagen siguiente">→</button>
            </div>
          )}
        </div>
        {hasCarousel && (
          <div class="rz-pe__thumb-strip" aria-label="Seleccionar imagen de la galería">
            {heroSlides.map((visual, imageIndex) => (
              <button type="button" class:list={['rz-pe__thumb', imageIndex === 0 && 'is-active']} data-pe-thumb data-pe-index={imageIndex} aria-label={`Mostrar imagen ${imageIndex + 1} de ${heroSlides.length}`} aria-pressed={imageIndex === 0 ? 'true' : 'false'}>
                <img src={visual.src} alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}
        <figcaption class="rz-pe__hero-caption">
          <span>{project.title}</span><span>{project.category}</span>
        </figcaption>
      </figure>
    </section>
  )}

  {(project.intro || hasFacts) && (
    <section class="rz-pe__overview section-pad" style="background-color:#4d4c3f;color:#f2e9d5" aria-labelledby="rz-pe-overview">
      <div class="rz-pe__section-identity">
        <p class="rz-pe__eyebrow">01 / Presentación</p>
        <h2 id="rz-pe-overview">El proyecto.</h2>
      </div>
      <div class="rz-pe__overview-detail">
        {project.intro && <p class="rz-pe__overview-lead">{project.intro}</p>}
        {hasFacts && <dl class="rz-pe__facts">
          {project.typology && <div><dt>Tipología</dt><dd>{project.typology}</dd></div>}
          {project.category && <div><dt>Disciplina</dt><dd>{project.category}</dd></div>}
          {project.participation && <div><dt>Participación de Rizzoma</dt><dd>{project.participation}</dd></div>}
          <div><dt>Dirección y autoría del trabajo de Rizzoma</dt><dd>Juan José Quintero Tobón</dd></div>
          {location && <div><dt>Ubicación</dt><dd>{location}</dd></div>}
          {project.year && <div><dt>Año</dt><dd>{project.year}</dd></div>}
        </dl>}
      </div>
    </section>
  )}

  {hasInsights && (
    <section class="rz-pe__insights section-pad" aria-labelledby="rz-pe-insights">
      <header class="rz-pe__section-header">
        <div>
          <p class="rz-pe__eyebrow">02 / La mirada de Rizzoma</p>
          <h2 id="rz-pe-insights">Lo que revela el proyecto.</h2>
        </div>
        <p>Una lectura de los aspectos que dan carácter a este trabajo y de lo que sus imágenes permiten comprender.</p>
      </header>
      <div class="rz-pe__insight-list">
        {insights.map((item, itemIndex) => (
          <article class:list={['rz-pe__insight', item.image ? 'rz-pe__insight--with-image' : '']}>
            <div class="rz-pe__insight-copy">
              <span class="rz-pe__number">{pad(itemIndex + 1)}</span>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
            </div>
            {item.image && (
              <figure class="rz-pe__insight-figure">
                <button
                  type="button"
                  class="rz-pe__image-trigger"
                  data-editorial-image
                  data-full-src={item.image.src}
                  data-full-alt={item.image.alt}
                  data-full-caption={item.image.caption ?? item.title}
                  aria-label={`Ampliar imagen de ${item.title}`}
                >
                  <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
                  <span class="rz-pe__zoom-indicator" aria-hidden="true">Ampliar ↗</span>
                </button>
                {item.image.caption && <figcaption>{item.image.caption}</figcaption>}
              </figure>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  {hasGallery && (
    <section class="rz-pe__tour section-pad" aria-labelledby="rz-pe-tour">
      <div class="rz-pe__section-header">
        <div>
          <p class="rz-pe__eyebrow">03 / Recorrido visual</p>
          <h2 id="rz-pe-tour">Miradas del proyecto.</h2>
        </div>
        <p>Un recorrido por sus espacios y perspectivas, con imágenes del archivo real de {project.title}.</p>
      </div>
      {visibleTour.map((group) => (
        <section class="rz-pe__tour-group" aria-label={group.title}>
          <div class="rz-pe__group-intro">
            <h3>{group.title}</h3>
            {group.description && <p>{group.description}</p>}
          </div>
          {group.display === 'gallery' ? (
            <figure class="rz-pe__hero rz-pe__tour-carousel">
              <div class="rz-pe__hero-stage" data-pe-gallery={JSON.stringify(group.images)}>
                <button
                  class="rz-pe__image-trigger rz-pe__hero-trigger"
                  type="button"
                  data-editorial-image
                  data-full-src={group.images[0].src}
                  data-full-alt={group.images[0].alt}
                  data-full-caption={group.images[0].caption ?? group.title}
                  aria-label={`Ampliar imagen 1 de ${group.title}`}
                >
                  <img src={group.images[0].src} alt={group.images[0].alt} data-pe-hero-img loading="lazy" decoding="async" />
                  <span class="rz-pe__zoom-indicator" aria-hidden="true">Ampliar ↗</span>
                </button>
                {group.images.length > 1 && (
                  <div class="rz-pe__carousel-controls" aria-label={`Controles de galería: ${group.title}`}>
                    <span data-pe-slide-counter aria-live="polite">01 / {pad(group.images.length)}</span>
                    <button type="button" data-pe-prev aria-label={`Imagen anterior de ${group.title}`}>←</button>
                    <button type="button" data-pe-next aria-label={`Imagen siguiente de ${group.title}`}>→</button>
                  </div>
                )}
              </div>
              {group.images.length > 1 && (
                <div class="rz-pe__thumb-strip" aria-label={`Seleccionar imagen de ${group.title}`}>
                  {group.images.map((visual, imageIndex) => (
                    <button
                      type="button"
                      class:list={['rz-pe__thumb', imageIndex === 0 && 'is-active']}
                      data-pe-thumb
                      aria-label={`Mostrar imagen ${imageIndex + 1} de ${group.title}`}
                      aria-pressed={imageIndex === 0 ? 'true' : 'false'}
                    >
                      <img src={visual.src} alt="" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              )}
              <figcaption class="rz-pe__hero-caption">
                <span data-pe-current-label>{group.images[0].caption ?? group.title}</span>
                <span>{group.title} / {project.title}</span>
              </figcaption>
            </figure>
          ) : (
            <div class:list={['rz-pe__visual-grid', group.images.length > 3 ? 'rz-pe__visual-grid--rhythm' : 'rz-pe__visual-grid--short']}>
              {group.images.map((visual, imageIndex) => (
                <figure class="rz-pe__visual">
                  <button
                    type="button"
                    class="rz-pe__image-trigger"
                    data-editorial-image
                    data-full-src={visual.src}
                    data-full-alt={visual.alt}
                    data-full-caption={visual.caption ?? group.title}
                    aria-label={`Ampliar imagen ${imageIndex + 1} de ${group.title}`}
                  >
                    <img src={visual.src} alt={visual.alt} loading="lazy" decoding="async" />
                    <span class="rz-pe__zoom-indicator" aria-hidden="true">Ampliar ↗</span>
                  </button>
                  {visual.caption && <figcaption>{visual.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </section>
      ))}
    </section>
  )}

  {hasArchive && (
    <section class="rz-pe__archive section-pad" aria-labelledby="rz-pe-archive">
      <div class="rz-pe__section-header">
        <div>
          <p class="rz-pe__eyebrow">04 / Archivo complementario</p>
          <h2 id="rz-pe-archive">Otras formas de verlo.</h2>
        </div>
        <p>Documentación adicional que amplía la lectura del proyecto, sin atribuir a las imágenes una fase de trabajo no confirmada.</p>
      </div>
      {archive.map((group) => (
        <section class="rz-pe__tour-group" aria-label={group.title}>
          <div class="rz-pe__group-intro">
            <h3>{group.title}</h3>
            {group.description && <p>{group.description}</p>}
          </div>
          <div class="rz-pe__visual-grid rz-pe__visual-grid--archive">
            {group.images.map((visual, imageIndex) => (
              <figure class="rz-pe__visual">
                <button
                  type="button"
                  class="rz-pe__image-trigger"
                  data-editorial-image
                  data-full-src={visual.src}
                  data-full-alt={visual.alt}
                  data-full-caption={visual.caption ?? group.title}
                  aria-label={`Ampliar documento visual ${imageIndex + 1}: ${group.title}`}
                >
                  <img src={visual.src} alt={visual.alt} loading="lazy" decoding="async" />
                  <span class="rz-pe__zoom-indicator" aria-hidden="true">Ampliar ↗</span>
                </button>
                {visual.caption && <figcaption>{visual.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      ))}
    </section>
  )}

  <footer class="rz-pe__ending section-pad" aria-labelledby="rz-pe-contact-heading">
    <div class="rz-pe__ending-topline">
      <span>Rizzoma / Siguiente paso</span>
      <span>Arquitectura + visualización</span>
    </div>
    <div class="rz-pe__ending-inner">
      <div class="rz-pe__ending-intro">
        <p class="rz-pe__eyebrow">Conversemos</p>
        <h2 id="rz-pe-contact-heading">¿Tienes un proyecto en mente?</h2>
      </div>
      <div class="rz-pe__ending-contact">
        <p>{project.closingText ?? 'Ya sea un espacio por diseñar, un proyecto que necesitas visualizar o una idea que buscas desarrollar, podemos conversar sobre lo que tienes en mente.'}</p>
        <a class="rz-pe__ending-cta" href={withBase('/contacto/')}>Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <nav class="rz-pe__ending-navigation" aria-label="Continuar explorando proyectos">
      <a href={withBase('/portafolio/')}>← Volver al portafolio</a>
      {nextProject
        ? <a href={withBase(`/proyectos/${nextProject.slug}/`)}>Siguiente proyecto: {nextProject.title} <span aria-hidden="true">→</span></a>
        : <span>Rizzoma Arquitectura</span>
      }
    </nav>
  </footer>

  {allVisuals.length > 0 && (
    <dialog class="rz-pe__lightbox" data-rz-pe-lightbox aria-label="Visor ampliado de imágenes del proyecto">
      <div class="rz-pe__lightbox-inside">
        <button class="rz-pe__lightbox-close" type="button" data-rz-pe-close aria-label="Cerrar imagen ampliada">Cerrar ×</button>
        <figure class="rz-pe__lightbox-figure">
          <img data-rz-pe-main alt="" />
          <figcaption data-rz-pe-caption></figcaption>
        </figure>
        <div class="rz-pe__lightbox-controls">
          <button type="button" data-rz-pe-prev aria-label="Imagen anterior">←</button>
          <span data-rz-pe-counter aria-live="polite"></span>
          <button type="button" data-rz-pe-next aria-label="Imagen siguiente">→</button>
        </div>
      </div>
    </dialog>
  )}
  <div hidden data-pe-catalog>
    {allVisuals.map((visual) => (
      <span data-pe-catalog-item data-full-src={visual.src} data-full-alt={visual.alt} data-full-caption={visual.caption ?? project.title}></span>
    ))}
  </div>
</article>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-rz-pe-lightbox]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-editorial-image]')];
  const catalog = [...document.querySelectorAll<HTMLElement>('[data-pe-catalog-item]')];
  const main = dialog?.querySelector<HTMLImageElement>('[data-rz-pe-main]');
  const caption = dialog?.querySelector<HTMLElement>('[data-rz-pe-caption]');
  const counter = dialog?.querySelector<HTMLElement>('[data-rz-pe-counter]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-rz-pe-close]');
  const prev = dialog?.querySelector<HTMLButtonElement>('[data-rz-pe-prev]');
  const next = dialog?.querySelector<HTMLButtonElement>('[data-rz-pe-next]');
  let active = 0;
  let origin: HTMLButtonElement | null = null;
  const show = (index: number) => {
    if (!main || !catalog.length) return;
    active = (index + catalog.length) % catalog.length;
    const visual = catalog[active];
    main.src = visual.dataset.fullSrc || '';
    main.alt = visual.dataset.fullAlt || '';
    if (caption) caption.textContent = visual.dataset.fullCaption || '';
    if (counter) counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(catalog.length).padStart(2, '0')}`;
    if (prev) prev.hidden = catalog.length < 2;
    if (next) next.hidden = catalog.length < 2;
  };
  triggers.forEach(trigger => trigger.addEventListener('click', () => {
    if (!dialog || !catalog.length) return;
    origin = trigger;
    const target = trigger.dataset.fullSrc;
    const index = catalog.findIndex(item => item.dataset.fullSrc === target);
    show(Math.max(0, index));
    dialog.showModal();
  }));
  close?.addEventListener('click', () => dialog?.close());
  prev?.addEventListener('click', () => show(active - 1));
  next?.addEventListener('click', () => show(active + 1));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => { if (main) main.removeAttribute('src'); origin?.focus(); });
  dialog?.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft') { event.preventDefault(); show(active - 1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); show(active + 1); }
  });

  // A shared carousel controller powers both exterior and interior galleries.
  // Scoping controls to their containing figure prevents galleries from interfering.
  document.querySelectorAll<HTMLElement>('[data-pe-gallery]').forEach((stage) => {
    const figure = stage.closest('figure');
    const displayed = stage.querySelector<HTMLImageElement>('[data-pe-hero-img]');
    const trigger = stage.querySelector<HTMLButtonElement>('[data-editorial-image]');
    const slideCounter = stage.querySelector<HTMLElement>('[data-pe-slide-counter]');
    const currentLabel = figure?.querySelector<HTMLElement>('[data-pe-current-label]');
    const thumbs = [...(figure?.querySelectorAll<HTMLButtonElement>('[data-pe-thumb]') ?? [])];
    const slides: { src: string; alt: string; caption?: string }[] = stage.dataset.peGallery
      ? JSON.parse(stage.dataset.peGallery)
      : [];
    let current = 0;
    const select = (index: number) => {
      if (!displayed || !trigger || !slides.length) return;
      current = (index + slides.length) % slides.length;
      const visual = slides[current];
      displayed.src = visual.src;
      displayed.alt = visual.alt;
      trigger.dataset.fullSrc = visual.src;
      trigger.dataset.fullAlt = visual.alt;
      trigger.dataset.fullCaption = visual.caption || '';
      trigger.setAttribute('aria-label', `Ampliar imagen ${current + 1} de ${slides.length}`);
      if (currentLabel) currentLabel.textContent = visual.caption || '';
      if (slideCounter) slideCounter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      thumbs.forEach((thumb, i) => {
        thumb.classList.toggle('is-active', i === current);
        thumb.setAttribute('aria-pressed', String(i === current));
      });
    };
    stage.querySelector('[data-pe-prev]')?.addEventListener('click', () => select(current - 1));
    stage.querySelector('[data-pe-next]')?.addEventListener('click', () => select(current + 1));
    thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => select(index)));
  });
</script>