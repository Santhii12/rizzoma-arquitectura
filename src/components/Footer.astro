---
import { site } from '@/config/site';
import { withBase } from '@/utils/paths';
---
<footer class="site-footer rizzoma-footer">
  <div class="footer-inner">
    <div class="footer-signature" aria-label="Rizzoma Arquitectura">
      <img class="footer-wordmark-image" src={withBase(site.brand.wordmark)} alt="Rizzoma" width="1000" height="220" loading="lazy" />
    </div>

    <div class="rizzoma-footer-lead">
      <p class="footer-kicker">Arquitectura · Diseño · Visualización</p>
      <p>Práctica independiente dirigida por {site.founder.name}.</p>
    </div>

    <div class="footer-grid rizzoma-footer-grid">
      <div class="footer-contact">
        <span>{site.location}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.whatsappUrl} target="_blank" rel="noreferrer">WhatsApp ↗</a>
      </div>

      <div class="footer-links">
        <a href={withBase('/proyectos/')}>Proyectos</a>
        <a href={withBase('/servicios/')}>Servicios</a>
        <a href={withBase('/estudio/')}>Estudio</a>
        <a href={withBase('/portafolio/')} target="_blank" rel="noopener noreferrer">Archivo visual ↗</a>
      </div>

      <div class="footer-links">
        <a href={site.instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
        <a href={withBase('/contacto/')}>Contacto</a>
        <a href={withBase('/privacidad/')}>Privacidad</a>
        <span>© {new Date().getFullYear()} Rizzoma</span>
      </div>
    </div>
  </div>
</footer>
