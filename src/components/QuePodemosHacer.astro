---
import { withBase } from '@/utils/paths';
import '@/styles/que-podemos-hacer.css';

interface Props {
  visualizacionImage: string;
  disenoImage?: string;
  remodelacionImage?: string;
}
const { visualizacionImage, disenoImage, remodelacionImage } = Astro.props;

const servicios = [
  {
    numero: '02',
    nombre: 'Modelado y documentación arquitectónica',
    titulo: 'Dar forma y claridad a las ideas.',
    descripcion: 'Desarrollamos modelos tridimensionales y dibujos o planos arquitectónicos definidos según la etapa, los insumos y el alcance de cada colaboración.',
    prestaciones: ['Modelado tridimensional.', 'Plantas y dibujos arquitectónicos según alcance.', 'Representación de volumetrías y organización espacial.'],
    imagen: disenoImage,
    alt: 'Planta arquitectónica de Casa El Santuario que documenta la distribución espacial propuesta',
    pie: 'Casa El Santuario · Planta arquitectónica',
  },
  {
    numero: '03',
    nombre: 'Visualización arquitectónica',
    titulo: 'Imágenes que comunican el proyecto.',
    descripcion: 'Producimos renders e imágenes para estudiar alternativas de diseño y comunicar propuestas arquitectónicas o comerciales, propias o de otros estudios.',
    prestaciones: ['Renders de interiores y exteriores.', 'Imágenes para presentaciones de diseño.', 'Visualización de fachada y comunicación comercial.'],
    imagen: remodelacionImage,
    alt: 'Cabo San Miguel: visualización comercial de fachada desarrollada por Rizzoma',
    pie: 'Cabo San Miguel · Diseño de fachada y visualización',
  }
];
---
<section class="rizzoma-offer" id="que-podemos-hacer" aria-labelledby="rizzoma-offer-title">
  <div class="rizzoma-offer__inner">
    <header class="rizzoma-offer__introduction">
      <div class="rizzoma-offer__intro-title">
        <p class="rizzoma-offer__eyebrow">Servicios / Rizzoma Arquitectura</p>
        <h2 id="rizzoma-offer-title" class="rizzoma-offer__headline">¿Qué podemos hacer por ti?</h2>
      </div>
      <div class="rizzoma-offer__intro-copy">
        <a class="rizzoma-offer__intro-cta" href={withBase('/servicios/')} aria-label="Conocer los tres servicios de Rizzoma Arquitectura">
          <span class="rizzoma-offer__intro-cta-content">
            <span class="rizzoma-offer__intro-cta-kicker">Desarrollo · Modelado y planos · Visualización</span>
            <span class="rizzoma-offer__intro-cta-title">Conoce nuestros servicios</span>
          </span>
          <span class="rizzoma-offer__intro-cta-arrow" aria-hidden="true">↗︎</span>
        </a>
        <p>Rizzoma colabora con arquitectos y estudios como apoyo externo en etapas y tareas específicas.</p>
        <p>También desarrolla propuestas propias. El trabajo se acuerda según los insumos, las responsabilidades y el alcance de cada encargo.</p>
      </div>
    </header>

    <article class="rizzoma-offer__featured" aria-labelledby="rizzoma-offer-visual-title">
      <figure class="rizzoma-offer__featured-visual">
        <img
          src={visualizacionImage}
          alt="Casa Patio Horizonte: visualización de una vivienda contemporánea integrada al paisaje natural"
          loading="lazy"
          decoding="async"
          width="2048"
          height="1529"
        />
        <figcaption>Casa Patio Horizonte <span>— Diseño arquitectónico de Rizzoma</span></figcaption>
      </figure>
      <div class="rizzoma-offer__featured-copy">
        <div class="rizzoma-offer__service-top">
          <span>01 / 03</span>
          <span>Desarrollo arquitectónico</span>
        </div>
        <h3 id="rizzoma-offer-visual-title">Arquitectura que parte del lugar.</h3>
        <p class="rizzoma-offer__description">Apoyamos la conceptualización, implantación y desarrollo de propuestas de diseño, desde la lectura del contexto hasta las decisiones de organización espacial.</p>
        <ul class="rizzoma-offer__capabilities">
          <li>Conceptualización arquitectónica.</li>
          <li>Estudio de implantación.</li>
          <li>Diseño y desarrollo arquitectónico según alcance.</li>
          <li>Apoyo a arquitectos y estudios independientes.</li>
        </ul>
        <a class="rizzoma-offer__case-link" href={withBase('/proyectos/casa-patio-horizonte/')}>Explorar Casa Patio Horizonte <span aria-hidden="true">↗︎</span></a>
      </div>
    </article>

    <div class="rizzoma-offer__secondary" aria-label="Modelado, documentación y visualización">
      {servicios.map((servicio) => (
        <article class="rizzoma-offer__secondary-card" aria-labelledby={`rizzoma-offer-${servicio.numero}`}>
          <div class="rizzoma-offer__secondary-top">
            <span>{servicio.numero} / 03</span>
            <span>{servicio.nombre}</span>
          </div>
          <figure class="rizzoma-offer__secondary-visual">
            {servicio.imagen ? (
              <img src={servicio.imagen} alt={servicio.alt} loading="lazy" decoding="async" width="1024" height="1360" />
            ) : (
              <div class="rizzoma-offer__image-pending" role="img" aria-label="Imagen del servicio pendiente de incorporar">Imagen de servicio pendiente</div>
            )}
            {servicio.imagen && <figcaption>{servicio.pie}</figcaption>}
          </figure>
          <div class="rizzoma-offer__secondary-content">
            <h3 id={`rizzoma-offer-${servicio.numero}`}>{servicio.titulo}</h3>
            <p class="rizzoma-offer__description">{servicio.descripcion}</p>
            <ul class="rizzoma-offer__capabilities">
              {servicio.prestaciones.map((prestacion) => <li>{prestacion}</li>)}
            </ul>
            <a class="rizzoma-offer__case-link" href={withBase(servicio.numero === '02' ? '/proyectos/casa-el-santuario/' : '/proyectos/cabo-san-miguel/')}>
              {servicio.numero === '02' ? 'Explorar Casa El Santuario' : 'Explorar Cabo San Miguel'} <span aria-hidden="true">↗︎</span>
            </a>
          </div>
        </article>
      ))}
    </div>


  </div>
</section>
