---
import type { Project } from '@/data/projects';
import { withBase } from '@/utils/paths';
interface Props { project: Project; index?: number; }
const { project, index = 0 } = Astro.props;
const meta = [project.location, project.region].filter(Boolean).join(' · ');
---
{project.available ? (
  <a class="project-card reveal" href={withBase(`/proyectos/${project.slug}/`)} aria-label={`Ver proyecto ${project.title}`}>
    <div class="project-media parallax-media">
      {project.cover && <img src={project.cover} alt={`${project.title} — ${project.category}`} loading={index > 0 ? 'lazy' : 'eager'} decoding="async" />}
      <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
      <span class="project-open" aria-hidden="true">Ver proyecto ↗</span>
    </div>
    <div class="project-info">
      <div>
        <h3>{project.title}</h3>
        {meta && <p>{meta}</p>}
      </div>
      <div class="project-meta"><span>{project.category}</span>{project.year && <span>{project.year}</span>}</div>
    </div>
  </a>
) : (
  <article class="project-card project-card--archive reveal" aria-label={`${project.title}, proyecto de Rizzoma`}>
    <div class="archive-project-row">
      <span class="archive-project-number">{String(index + 1).padStart(2, '0')}</span>
      <div class="archive-project-title">
        <h3>{project.title}</h3>
        <p>{meta || 'Rizzoma Arquitectura'}</p>
      </div>
      <span class="archive-project-category">{project.category}</span>
      <span class="archive-project-year">{project.year ?? '—'}</span>
    </div>
  </article>
)}
