---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/config/site';
import '@/styles/global-1.css';
import '@/styles/global-2.css';
import '@/styles/global-3.css';
import '@/styles/global-4.css';
import { withBase } from '@/utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'Rizzoma Arquitectura — Arquitectura, diseño y visualización',
  description = site.description,
  image = site.ogImage,
  type = 'website',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.domain);
const socialImage = image.startsWith('http') ? image : new URL(withBase(image), Astro.site ?? site.domain).toString();
const deployedSite = (Astro.site ?? new URL(site.domain)).toString().replace(/\/$/, '');
const founderImage = new URL(withBase(site.founder.portrait), Astro.site ?? site.domain).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${deployedSite}/#website`,
      url: deployedSite,
      name: site.name,
      inLanguage: 'es-CO'
    },
    {
      '@type': 'Person',
      '@id': `${deployedSite}/#juan-jose-quintero`,
      name: site.founder.name,
      jobTitle: 'Arquitecto',
      image: founderImage,
      worksFor: { '@id': `${deployedSite}/#business` }
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${deployedSite}/#business`,
      name: site.name,
      url: deployedSite,
      description: site.description,
      email: site.email,
      telephone: '+57 315 741 4871',
      areaServed: { '@type': 'Country', name: 'Colombia' },
      founder: { '@id': `${deployedSite}/#juan-jose-quintero` },
      sameAs: [site.instagramUrl]
    }
  ]
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#61604e" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase(site.brand.monogram)} />
    
    <link rel="preconnect" href="https://framerusercontent.com" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
