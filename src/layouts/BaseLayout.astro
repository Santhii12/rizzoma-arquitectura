---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/config/site';
import '@/styles/global-1.css';
import '@/styles/global-2.css';
import '@/styles/global-3.css';
import '@/styles/global-4.css';
import '@/styles/global-5.css';
import { withBase } from '@/utils/paths';

type JsonLd = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: JsonLd | JsonLd[];
}

const {
  title = 'Rizzoma Arquitectura | Arquitectura y visualización en Medellín',
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  type = 'website',
  noindex = false,
  schema
} = Astro.props;

const baseSite = Astro.site ?? new URL(site.domain);
const canonical = new URL(Astro.url.pathname, baseSite);
const socialImage = image.startsWith('http') ? image : new URL(withBase(image), baseSite).toString();
const deployedSite = baseSite.toString().replace(/\/$/, '');
const founderImage = new URL(withBase(site.founder.portrait), baseSite).toString();
const logo = new URL(withBase(site.brand.wordmark), baseSite).toString();

const coreGraph: JsonLd[] = [
  {
    '@type': 'WebSite',
    '@id': `${deployedSite}/#website`,
    url: deployedSite,
    name: site.name,
    alternateName: site.shortName,
    description: site.description,
    inLanguage: 'es-CO',
    publisher: { '@id': `${deployedSite}/#business` }
  },
  {
    '@type': 'Person',
    '@id': `${deployedSite}/#juan-jose-quintero`,
    name: site.founder.name,
    jobTitle: 'Arquitecto',
    image: founderImage,
    url: new URL(withBase('/estudio/'), baseSite).toString(),
    worksFor: { '@id': `${deployedSite}/#business` }
  },
  {
    '@type': 'ProfessionalService',
    '@id': `${deployedSite}/#business`,
    name: site.name,
    alternateName: site.shortName,
    url: deployedSite,
    logo,
    image: socialImage,
    description: site.description,
    email: site.email,
    telephone: '+57 315 741 4871',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Medellín',
      addressRegion: 'Antioquia',
      addressCountry: 'CO'
    },
    areaServed: [
      { '@type': 'City', name: 'Medellín' },
      { '@type': 'AdministrativeArea', name: 'Antioquia' },
      { '@type': 'Country', name: 'Colombia' }
    ],
    founder: { '@id': `${deployedSite}/#juan-jose-quintero` },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: '+57 315 741 4871',
      email: site.email,
      availableLanguage: ['es'],
      areaServed: 'CO'
    },
    sameAs: [site.instagramUrl],
    knowsAbout: [...site.services, 'Arquitectura', 'Paisaje', 'Materialidad', 'Representación arquitectónica'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de Rizzoma Arquitectura',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Arquitectura',
            url: new URL(withBase('/arquitectura-medellin/'), baseSite).toString()
          }
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Diseño + visualización',
            url: new URL(withBase('/servicios/'), baseSite).toString()
          }
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Visualización arquitectónica y renders',
            url: new URL(withBase('/visualizacion-arquitectonica-medellin/'), baseSite).toString()
          }
        }
      ]
    }
  }
];

const extraGraph = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [...coreGraph, ...extraGraph]
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#61604e" />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content={site.name} />
    <meta name="author" content={site.founder.name} />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'none'; object-src 'none'; img-src 'self' https://framerusercontent.com data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; form-action 'self'; upgrade-insecure-requests" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-CO" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase(site.brand.monogram)} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="me" href={site.instagramUrl} />
    <link rel="preconnect" href="https://framerusercontent.com" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1493" />
    <meta property="og:image:height" content="1054" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
